function D.logger(tag)
	return function(msg)
		if _G.CreateLabel then
			_G.CreateLabel("[" .. tag .. "]: " .. msg)
		else
			print("[" .. tag .. "]: " .. msg)
		end
	end
end

function D.getMe()
	local char = lplr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if hum and root and hum.Health > 0 then
		return char, hum, root
	end
end

function D.getParts(p)
	local char = p.Character
	return char, char and char:FindFirstChildOfClass("Humanoid"), char and char:FindFirstChild("HumanoidRootPart")
end

-- Exact name / display name first (so "00" picks the player called 00), then a prefix match. "@name" = username only.
function D.findPlayer(name, includeSelf)
	name = tostring(name):lower()
	local usernameOnly = false
	if name:sub(1, 1) == "@" then
		name, usernameOnly = name:sub(2), true
	end
	local function matches(p, exact)
		if p == lplr and not includeSelf then return false end
		local n, d = p.Name:lower(), p.DisplayName:lower()
		if exact then
			return n == name or (not usernameOnly and d == name)
		end
		return n:sub(1, #name) == name or (not usernameOnly and d:sub(1, #name) == name)
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if matches(p, true) then return p end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if matches(p, false) then return p end
	end
end

-- Every prefix match (for commands that take a whole group)
function D.findPlayers(name)
	name = tostring(name):lower()
	local found = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lplr and (p.Name:lower():sub(1, #name) == name or p.DisplayName:lower():sub(1, #name) == name) then
			table.insert(found, p)
		end
	end
	return found
end

function D.findTeam(name)
	name = name:lower()
	for _, team in ipairs(game:GetService("Teams"):GetTeams()) do
		if team.Name:lower():sub(1, #name) == name then
			return team
		end
	end
end

function D.isNeutral(p)
