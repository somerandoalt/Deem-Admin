end

local findPlayer = D.findPlayer

local inPrison = D.inPrison
-- While we're a Criminal with a forcefield on (just respawned), don't teleport into the prison
local function shouldWait(char, tRoot) return D.ffBlocks(tRoot.Position) end

-- Presses the punch key every way we can, because which one the game accepts depends on the executor
local function pressPunch()
	pcall(function() VirtualInputManager:SendKeyEvent(true, PUNCH_KEY, false, game) end)
	if keypress then pcall(keypress, PUNCH_KEYCODE) end
	-- a tool in your hands (e.g. Fists) can also be swung directly
	local char = lplr.Character
	local tool = char and char:FindFirstChildOfClass("Tool")
	if tool then pcall(function() tool:Activate() end) end
	task.delay(0.03, function()
		pcall(function() VirtualInputManager:SendKeyEvent(false, PUNCH_KEY, false, game) end)
		if keyrelease then pcall(keyrelease, PUNCH_KEYCODE) end
	end)
end

-- Smoothly moves the root toward a CFrame (frame-rate independent). Returns true once it has arrived.
local function glideTo(root, goal, dt)
	local alpha = 1 - math.exp(-GLIDE_SPEED * dt)
	root.CFrame = root.CFrame:Lerp(goal, alpha)
	return (root.Position - goal.Position).Magnitude < 0.4
end

