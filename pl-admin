-- antisit ------------------------------------------------------------------------------
-- Stops your character from sitting. forcecrim / carbring / ufo / spamcars pause it while they run.
do
	local out = D.logger("antisit")
	local state = _G.DeemAntiSit
	if type(state) ~= "table" then
		state = { enabled = false, pauses = 0 }
		_G.DeemAntiSit = state
	end
	function state.pause() state.pauses = state.pauses + 1 end
	function state.resume() state.pauses = math.max(0, state.pauses - 1) end

	local lastHum, lastBlocking
	local function enforce()
		local hum = getHum()
		if not hum then return end
		local blocking = state.enabled and state.pauses <= 0
		if hum ~= lastHum or blocking ~= lastBlocking then
			lastHum, lastBlocking = hum, blocking
			pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Seated, not blocking) end)
		end
		if blocking and (hum.Sit or hum.SeatPart) then
			hum.Sit = false
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
		end
	end
	if state.conn then state.conn:Disconnect() end
	state.conn = RunService.Heartbeat:Connect(enforce)

	Commands.antisit = function(arg)
		local a = arg and tostring(arg):lower()
		if a == "reset" then
			state.pauses = 0
			enforce()
			return out("Cleared any stuck pause (anti-sit is " .. (state.enabled and "ON" or "OFF") .. ")")
		end
		if a == "on" then state.enabled = true
		elseif a == "off" then state.enabled = false
		else state.enabled = not state.enabled end
		enforce()
		out("Anti-sit " .. (state.enabled and "ON" or "OFF")
			.. (state.pauses > 0 and " (paused right now while another command is using seats)" or ""))
	end
end

-- antiarrest ---------------------------------------------------------------------------
-- When you get arrested (Remotes.ClientArrested fires) you're put straight back where you were standing.
do
	local out = D.logger("antiarrest")
	local HISTORY_SECONDS, ARREST_LAG, RETURN_WINDOW, CLOSE_ENOUGH = 1.0, 0.25, 4.5, 4
	local state = _G.DeemAntiArrest
	if type(state) ~= "table" then
		state = { enabled = false, conns = {}, history = {}, pending = nil }
		_G.DeemAntiArrest = state
	end
	local function disconnectAll()
		for _, c in ipairs(state.conns) do pcall(function() c:Disconnect() end) end
		table.clear(state.conns)
	end
	-- Position we were at ARREST_LAG seconds ago (the server may already be moving us toward the cell)
	local function positionBeforeNow()
		local now, pick = os.clock(), nil
		for _, entry in ipairs(state.history) do
			if now - entry[1] >= ARREST_LAG then pick = entry[2] end
		end
		return pick or (state.history[1] and state.history[1][2])
	end
	local function onArrested()
		if not state.enabled or state.pending then return end
		local cf = positionBeforeNow()
		if not cf then return out("Arrested, but I have no saved position to return you to") end
		state.pending = { cf = cf, untilT = os.clock() + RETURN_WINDOW }
		out("Arrest detected - returning you to where it happened")
	end
	local function step()
		local char, hum, root = lplr.Character, getHum(), lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")
		local pending = state.pending
		if pending then
			if os.clock() > pending.untilT then
				state.pending = nil
				table.clear(state.history)
			elseif root and hum and hum.Health > 0 and (root.Position - pending.cf.Position).Magnitude > CLOSE_ENOUGH then
				if hum.SeatPart then hum.Sit = false end
				root.AssemblyLinearVelocity = Vector3.zero
				char:PivotTo(pending.cf)
			end
			return
		end
		if root and hum and hum.Health > 0 then
			local now = os.clock()
			table.insert(state.history, { now, root.CFrame })
			while #state.history > 1 and now - state.history[1][1] > HISTORY_SECONDS do
				table.remove(state.history, 1)
			end
		end
	end
	local function setEnabled(on)
		disconnectAll()
		state.pending = nil
		table.clear(state.history)
		state.enabled = on
		if not on then return end
		table.insert(state.conns, RunService.Heartbeat:Connect(step))
		task.spawn(function()
			local remotes = ReplicatedStorage:FindFirstChild("Remotes")
			local ev = remotes and remotes:WaitForChild("ClientArrested", 10)
			if not ev then return out("Couldn't find Remotes.ClientArrested") end
			if state.enabled then table.insert(state.conns, ev.OnClientEvent:Connect(onArrested)) end
		end)
	end
	Commands.antiarrest = function(arg)
		local a = arg and tostring(arg):lower()
		local want = (a == "on") or (a ~= "off" and not state.enabled)
		setEnabled(want)
		out(want and "ON - if you get arrested you'll be teleported back to where it happened" or "OFF")
	end
end

-- returnbydeath ------------------------------------------------------------------------
-- Every time you die / reset you're teleported back to where you died as soon as you respawn.
do
	local out = D.logger("returnbydeath")
	local RESPAWN_SETTLE, FF_APPEAR_GRACE, FF_STABLE = 0.15, 2, 0.4
	local state = _G.DeemReturnByDeath
	if type(state) ~= "table" then
		state = { enabled = false, conns = {}, lastAlive = nil, lastDeath = nil }
		_G.DeemReturnByDeath = state
	end
	local function getRoot(char)
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		return hum and hum.RootPart or (char and char:FindFirstChild("HumanoidRootPart"))
	end
	local function disconnectAll()
		for _, c in ipairs(state.conns) do pcall(function() c:Disconnect() end) end
		table.clear(state.conns)
	end
	local function hookCharacter(char)
		local hum = char:WaitForChild("Humanoid", 10)
		if not hum or not state.enabled then return end

		local target = state.lastDeath -- set by the previous character's Died event
		if target then
			task.spawn(function()
				local root
				local t = os.clock()
				repeat
					root = getRoot(char)
					task.wait()
				until root or os.clock() - t > 5
				if not root or not state.enabled or lplr.Character ~= char then return end
				task.wait(RESPAWN_SETTLE)
				-- The team and forcefield are applied a moment AFTER the character spawns, so checking right away finds
				-- "no forcefield" and teleports too early: give them time to show up, then wait until the forcefield is
				-- gone AND has stayed gone for FF_STABLE seconds.
				if D.inPrison(target.Position) then
					local t0 = os.clock()
					while state.enabled and lplr.Character == char and os.clock() - t0 < FF_APPEAR_GRACE do
						local team = lplr.Team
						if team ~= nil and team.Name == "Criminals" and char:FindFirstChildOfClass("ForceField") then break end
						if team ~= nil and team.Name ~= "Criminals" and os.clock() - t0 > 0.5 then break end
						task.wait(0.05)
					end
					local clearSince
					while state.enabled and lplr.Character == char do
						if D.ffGate(target.Position, out) then
							clearSince = nil
						else
							clearSince = clearSince or os.clock()
							if os.clock() - clearSince >= FF_STABLE then break end
						end
						task.wait(0.05)
					end
				end
				if not state.enabled or lplr.Character ~= char then return end
				if hum.SeatPart then
					hum.Sit = false
					task.wait(0.1)
				end
				root.AssemblyLinearVelocity = Vector3.zero
				char:PivotTo(target)
				state.lastDeath = nil
			end)
		end

		-- Remember where we are while alive (the root part can already be gone by the time Died fires)
		local alive = RunService.Heartbeat:Connect(function()
			local r = getRoot(char)
			if r and hum.Health > 0 then state.lastAlive = r.CFrame end
		end)
		table.insert(state.conns, alive)
		table.insert(state.conns, hum.Died:Connect(function()
			alive:Disconnect()
			local r = getRoot(char)
			state.lastDeath = r and r.CFrame or state.lastAlive
		end))
	end
	Commands.returnbydeath = function(arg)
		local a = arg and tostring(arg):lower()
		local want = (a == "on") or (a ~= "off" and not state.enabled)
		disconnectAll()
		state.lastDeath = nil
		state.enabled = want
		if want then
			table.insert(state.conns, lplr.CharacterAdded:Connect(hookCharacter))
			if lplr.Character then task.spawn(hookCharacter, lplr.Character) end
			out("ON - you'll be teleported back to where you died every time you respawn")
		else
			out("OFF")
		end
	end
end

-- silentgun ----------------------------------------------------------------------------
-- GripPos of any gun you hold = 3000,3000,3000 so the gun (and the shots) sit far away from you.
do
	local out = D.logger("silentgun")
	local GRIP = Vector3.new(3000, 3000, 3000)
	local state = _G.DeemSilentGun
	if type(state) ~= "table" then
		state = { enabled = false, originals = {} }
		_G.DeemSilentGun = state
	end
	local function isGun(tool)
		return tool:IsA("Tool") and tool.Name ~= "Handcuffs" and tool:FindFirstChild("Handle") ~= nil
			and tool:GetAttribute("FireRate") ~= nil
	end
	local function step()
		if not state.enabled then return end
		local char = lplr.Character
		if not char then return end
		for _, child in ipairs(char:GetChildren()) do
			if isGun(child) then
				pcall(function()
					if state.originals[child] == nil then state.originals[child] = child.GripPos end
					if child.GripPos ~= GRIP then child.GripPos = GRIP end
				end)
			end
		end
	end
	local function restore()
		for tool, grip in pairs(state.originals) do
			if tool.Parent then pcall(function() tool.GripPos = grip end) end
		end
		table.clear(state.originals)
	end
	if state.conn then state.conn:Disconnect() end
	state.conn = RunService.Heartbeat:Connect(step)

	Commands.silentgun = function(arg)
		local a = arg and tostring(arg):lower()
		state.enabled = (a == "on") or (a ~= "off" and not state.enabled)
		if state.enabled then
			out("ON - any gun you equip gets GripPos 3000, 3000, 3000 (run 'silentgun' again to stop)")
			step()
		else
			restore()
			out("OFF - guns put back to normal")
		end
	end
end

