local function playerFromPart(part)
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		local p = Players:GetPlayerFromCharacter(model)
		if p then return p end
		model = model.Parent and model.Parent:FindFirstAncestorOfClass("Model")
	end
end

local function validVictim(p, target)
	if not p or p == lplr or p == target then return false end
	local c = p.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	return c ~= nil and c:FindFirstChild("HumanoidRootPart") ~= nil and h ~= nil and h.Health > 0
end

-- Finds a player by the start of their name / display name (not you, not the stand user)
local function findPlayerByName(name, target)
	name = name:lower()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lplr and p ~= target
			and (p.Name:lower():sub(1, #name) == name or p.DisplayName:lower():sub(1, #name) == name) then
			return p
		end
	end
end

-- Star Finger helpers ---------------------------------------------------------------------
-- "Hostile" / "Trespassing" are read from the player, and from their character too in case the game puts them there
local function flag(p, name)
	if p:GetAttribute(name) == true then return true end
	local c = p.Character
	return c ~= nil and c:GetAttribute(name) == true
end
local function teamName(p) return p.Team and p.Team.Name or "" end
local function isGuard(p) return teamName(p):lower():find("guard", 1, true) ~= nil end

-- Returns "gun" | "melee" | "arrest" | "deny", plus a short reason for the log
local function sfDecide(v)
	local hostile, trespassing = flag(v, "Hostile"), flag(v, "Trespassing")
	if isGuard(lplr) then
		if teamName(v) == "Criminals" then return "gun", "a Criminal" end
		if hostile then return "gun", "Hostile" end
		if trespassing then return "arrest", "Trespassing" end
		return "deny", "not a Criminal, Hostile or Trespassing"
	end
	-- Hostile / Trespassing decide it first, whatever team they're on (a team mate who is Hostile still gets shot)
	if isGuard(v) then return "gun", "a Guard" end -- Criminals / Inmates shoot Guards
	if hostile then return "gun", "Hostile" end
	if trespassing then return "gun", "Trespassing" end
	if lplr.Team ~= nil and lplr.Team == v.Team then return "melee", "on your team and not Hostile/Trespassing" end
	return "melee", "not Hostile or Trespassing"
end

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function getRemington()
	local char = lplr.Character
	return (char and char:FindFirstChild(SF_GUN_NAME)) or lplr.Backpack:FindFirstChild(SF_GUN_NAME)
end

-- Teleports to the gun spot, picks up the Remington, then waits (up to 3s) for it to show up
local function fetchRemington(move)
	move.fetching = true
	task.spawn(function()
		local char = lplr.Character
		local r = char and char:FindFirstChild("HumanoidRootPart")
		if r then r.CFrame = CFrame.new(SF_GUN_SPOT) end
		task.wait(0.3)
		pcall(function()
			local item = workspace.Prison_ITEMS.giver[SF_GUN_NAME]:GetChildren()[3]
			ReplicatedStorage.Remotes.InteractWithItem:InvokeServer(item)
		end)
		local t = os.clock()
		while not getRemington() and os.clock() - t < 3 do task.wait(0.1) end
		move.fetching = false
		move.fetched = true
	end)
end

-- True if nothing but the victim is between a point and their head (other players don't count as walls)
local function clearShot(fromPos, vChar, char)
	local head = vChar:FindFirstChild("Head") or vChar:FindFirstChild("HumanoidRootPart")
	if not head then return false end
	local ignore = { char }
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character and p.Character ~= vChar then table.insert(ignore, p.Character) end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	local res = workspace:Raycast(fromPos, head.Position - fromPos, params)
	return res == nil or res.Instance:IsDescendantOf(vChar)
end

-- The places you can shoot from, in order of preference: 1 the stand user's side, 2 behind the target, 3 their left, 4 their right
local function sfSpots(vRoot, tRoot)
	local cf = vRoot.CFrame
	local dir = vRoot.Position - tRoot.Position
	dir = Vector3.new(dir.X, 0, dir.Z)
	if dir.Magnitude < 0.1 then
		local look = tRoot.CFrame.LookVector
		dir = Vector3.new(look.X, 0, look.Z)
	end
	dir = dir.Unit
	local y = vRoot.Position.Y
	local base = {
		vRoot.Position - dir * SF_DISTANCE,
		(cf * CFrame.new(0, 0, SF_DISTANCE)).Position,
		(cf * CFrame.new(-SF_DISTANCE, 0, 0)).Position,
		(cf * CFrame.new(SF_DISTANCE, 0, 0)).Position,
	}
	local spots = {}
	for i, p in ipairs(base) do
		local pos = Vector3.new(p.X, y, p.Z)
		spots[i] = CFrame.lookAt(pos, Vector3.new(vRoot.Position.X, y, vRoot.Position.Z))
	end
	return spots
end

-- Raycasts forward from the stand user; the first player hit (walls block the ray) is the victim
local function findVictim(char, tChar, tRoot, target)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char, tChar }
	for _, deg in ipairs(SCAN_ANGLES) do
		local dir = (tRoot.CFrame * CFrame.Angles(0, math.rad(deg), 0)).LookVector
		local hit = workspace:Raycast(tRoot.Position, dir * SCAN_RANGE, params)
		if hit then
			local p = playerFromPart(hit.Instance)
			if validVictim(p, target) then return p end
		end
	end
	-- Rays missed (thin rays can slip past a moving player): fall back to the closest player in a wide cone in front
	local look = tRoot.CFrame.LookVector
	local best, bestDist
	for _, p in ipairs(Players:GetPlayers()) do
		if validVictim(p, target) then
			local off = p.Character.HumanoidRootPart.Position - tRoot.Position
			local dist = off.Magnitude
			if dist <= SCAN_RANGE and dist > 0.1 and off.Unit:Dot(look) > 0.7 and (not bestDist or dist < bestDist) then
				best, bestDist = p, dist
			end
		end
	end
	return best
end

-- Where you stand while hitting: ATTACK_DISTANCE from the victim, on the stand user's side, facing them
local function victimPosition(vRoot, tRoot)
	local dir = vRoot.Position - tRoot.Position
	dir = Vector3.new(dir.X, 0, dir.Z)
	if dir.Magnitude < 0.1 then
		local look = tRoot.CFrame.LookVector
		dir = Vector3.new(look.X, 0, look.Z)
	end
	dir = dir.Unit
	local pos = vRoot.Position - dir * ATTACK_DISTANCE
	return CFrame.lookAt(pos, Vector3.new(vRoot.Position.X, pos.Y, vRoot.Position.Z))
end

local meleeEvent
local function getMelee()
	if meleeEvent and meleeEvent.Parent then return meleeEvent end
	meleeEvent = game:GetService("ReplicatedStorage"):FindFirstChild("meleeEvent")
	return meleeEvent
end

-- One hit on the victim, with a punch animation
local function hit(victim, hum)
	local ev = getMelee()
	if ev then
		pcall(function() ev:FireServer(victim, 1, 1) end)
	end
	local atk = state.atk
	if not atk or atk.hum ~= hum then
		atk = { hum = hum, tracks = {}, i = 0 }
		for _, id in ipairs(ATTACK_ANIMS) do
			local a = Instance.new("Animation")
			a.AnimationId = "rbxassetid://" .. id
			local ok, t = pcall(function() return hum:LoadAnimation(a) end)
			if ok and t then
				t.Priority = Enum.AnimationPriority.Action
				table.insert(atk.tracks, t)
			end
		end
		state.atk = atk
	end
	if #atk.tracks > 0 then
		atk.i = atk.i % #atk.tracks + 1 -- alternate between the two punch animations
		local t = atk.tracks[atk.i]
		t:Stop(0)
		t:Play(0.02)
	end
end

local function countMatches(text, patterns)
	local n = 0
	for _, p in ipairs(patterns) do
		for _ in text:gmatch(p) do n = n + 1 end
	end
	return n
end

-- Running Deem Admin commands for the stand user -------------------------------------------
-- Runs a built-in command the way the admin would (name or nickname)
local function runCommand(name, args)
	return pcall(D.runCommand, name, table.unpack(args))
end

local function runStandCommand(name, spec, args)
	local same = state.cmd ~= nil and state.cmd.name == name
	local ok, err = runCommand(name, args)
	if not ok then
		return out("Error running " .. name .. ": " .. tostring(err))
	end
	if same or not spec.running() then
		return -- a follow-up like "ufo sky", or it didn't start (usage error / "hug stop")
	end
	-- The command now owns your character: drop any move and the copied animations, and stop following
	state.move = nil
	sfCleanup()
	if state.mirrors then
		for _, m in pairs(state.mirrors) do pcall(function() m:Stop(0) m:Destroy() end) end
		table.clear(state.mirrors)
	end
	state.cmd = { name = name, spec = spec }
	out("Running '" .. name .. "' for " .. state.target.Name .. " - the stand waits until it's done")
end

-- "return" / "recall": cancel the running command with its own stop command
local function endStandCommand()
	local cmd = state.cmd
	if not cmd then return end
	if not cmd.spec.stop then
		return out(cmd.name .. " can't be cancelled - the stand resumes when it finishes")
	end
	local parts = {}
	for w in cmd.spec.stop:gmatch("%S+") do table.insert(parts, w) end
	local stopName = table.remove(parts, 1)
	local ok, err = runCommand(stopName, parts)
	if not ok then out("Error stopping " .. cmd.name .. ": " .. tostring(err)) end
end

-- Chat out (public + whispers) -------------------------------------------------------------
-- Sent the way the quizbot does it: TextChatService RBXGeneral:SendAsync, one message at a time with a 2.3s gap
-- (its minMessageCooldown, to avoid the rate limit), long text split at 200 characters as "(1/2)", "(2/2)".
local CHAT_COOLDOWN = 2.3
local CHAT_MAX = 200
local HELP_ON_START = true      -- whisper the stand user the list of things they can say when the stand starts
local chatQueue, chatPumping, chatLastSent = {}, false, 0

local function splitMessage(text)
	if #text <= CHAT_MAX then return { text } end
	local room = CHAT_MAX - 8 -- space for " (10/10)"
	local parts, cur = {}, ""
	for word in text:gmatch("%S+") do
		if #cur + #word + 1 > room and cur ~= "" then
			table.insert(parts, cur)
			cur = word
		else
			cur = cur == "" and word or (cur .. " " .. word)
		end
	end
	if cur ~= "" then table.insert(parts, cur) end
	for i, p in ipairs(parts) do parts[i] = string.format("%s (%d/%d)", p, i, #parts) end
	return parts
end

local function chatPump()
	if chatPumping then return end
	chatPumping = true
	task.spawn(function()
		while #chatQueue > 0 do
			local job = table.remove(chatQueue, 1)
			local gap = CHAT_COOLDOWN - (os.clock() - chatLastSent)
			if gap > 0 then task.wait(gap) end
			chatLastSent = os.clock()
			local ok, err = pcall(job)
			if not ok then out("Chat failed: " .. tostring(err)) end
		end
		chatPumping = false
	end)
end

-- public chat
local function say(text)
	for _, part in ipairs(splitMessage(text)) do
		table.insert(chatQueue, function()
			local channels = TextChatService:FindFirstChild("TextChannels")
			local general = channels and channels:FindFirstChild("RBXGeneral")
			if general then
				general:SendAsync(part)
			else -- legacy chat
				ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(part, "All")
			end
		end)
	end
	chatPump()
end

-- Whispers, the way the ChatTranslator script does them: if a whisper with that player is already open, send
-- straight into it; otherwise type "/w <display name> <message>" into Roblox's chat bar and submit it through the
-- bar's own handlers (Roblox's /w only recognises DISPLAY names). A "/w ..." line is never sent as public chat.
local function findWhisperChannel(plr)
	local channels = TextChatService:FindFirstChild("TextChannels")
	if not channels then return nil end
	for _, ch in ipairs(channels:GetChildren()) do
		if ch.Name:find("^RBXWhisper:") and ch.Name:find(tostring(plr.UserId), 1, true) and ch.Name:find(tostring(lplr.UserId), 1, true) then
			return ch
		end
	end
end

local function findChatBox()
	local ok, box = pcall(function()
		local ec = CoreGui:FindFirstChild("ExperienceChat")
		local bar = ec and ec:FindFirstChild("chatInputBar", true)
		return bar and bar:FindFirstChildWhichIsA("TextBox", true)
	end)
	return ok and box or nil
end

local function whisperNow(plr, text)
	local ch = findWhisperChannel(plr)
	if ch and pcall(function() ch:SendAsync(text) end) then return true end
	local box = findChatBox()
	if box and getconnections then
		box.Text = "/w " .. plr.DisplayName .. " " .. text
		local fired = false
		for _, c in ipairs(getconnections(box.FocusLost)) do
			if pcall(function() c:Fire(true) end) then fired = true end
		end
		if fired then return true end
		box.Text = ""
	end
	return false
end

local function whisper(plr, text)
	for _, part in ipairs(splitMessage(text)) do
		table.insert(chatQueue, function()
			if not whisperNow(plr, part) then
				out("Couldn't whisper " .. plr.Name .. " (send them one /w by hand first): " .. part)
			end
		end)
	end
	chatPump()
end

-- What the stand user can say, built from the real tables so it never goes out of date
local function helpLines()
	local names = {}
	for name in pairs(Stand_commands) do table.insert(names, name) end
	table.sort(names)
	return {
		"STAND punching (kill aura on the first player in front of you): say ora / muda = barrage (longer chant = longer), punch = one hit. Your own punch also makes me hit once.",
		"ZA WARUDO <player> = I circle them at top speed and punch until they're dead. STAR FINGER <player> = shoot / arrest / punch them depending on team + Hostile/Trespassing.",
		"return / recall / stand back = cancel the current move.",
		"STAND commands (say the word then a name, 'me' = you): " .. table.concat(names, ", ") .. ". Say 'return' to cancel one. Say 'stand help' to hear this again.",
	}
end

local function whisperHelp(plr)
	for _, line in ipairs(helpLines()) do whisper(plr, line) end
end

-- A line the stand user said: find the first move it triggers
local function handleChat(text)
	text = tostring(text):lower()

	-- "stand help" / "stand commands": whisper them what they can say
	if text:find("stand%s*help") or text:find("stand%s*commands") or text:find("stand%s*cmds") then
		whisperHelp(state.target)
		return
	end

	-- A Deem Admin command from Stand_commands: "<command> <args>" (the command is the first word)
	local words = {}
	for w in text:gmatch("%S+") do table.insert(words, w) end
	local cmdName = words[1]
	-- Nicknames: if the first word isn't a command itself, look it up in the aliases you set with "alias <nick> <command>"
	-- (read live from admin.lua through _G.DeemAliases) and in Stand_aliases above, e.g. "bomb bob" for "tpbomb bob"
	local liveAliases = type(_G.DeemAliases) == "table" and _G.DeemAliases or nil
	local hops = 0
	while cmdName and not Stand_commands[cmdName] and hops < 5 do
		local nxt = (liveAliases and liveAliases[cmdName]) or Stand_aliases[cmdName]
		if type(nxt) ~= "string" then break end
		cmdName = nxt:lower()
		hops = hops + 1
	end
	local cmdSpec = cmdName and Stand_commands[cmdName]
	if cmdSpec then
		table.remove(words, 1)
		for i, w in ipairs(words) do
			if w == "me" then words[i] = state.target.Name end
		end
		runStandCommand(cmdName, cmdSpec, words)
		return
	end

	-- While a command is running, only "return" / "recall" do anything
	if state.cmd then
		for _, m in ipairs(MOVES) do
			if m.kind == "cancel" and countMatches(text, m.patterns) > 0 then
				endStandCommand()
				return
			end
		end
		return
	end

	-- Za Warudo: "za warudo <player>"
	local _, zwEnd = text:find(ZW_PATTERN)
	if zwEnd then
		local name = text:sub(zwEnd + 1):match("(%S+)")
		name = name and name:gsub("[%.,!%?:;]+$", "")
		local victim = name and name ~= "" and findPlayerByName(name, state.target)
		if victim then
			state.move = { kind = "zawarudo", zw = true, victim = victim, untilT = os.clock() + ZW_MAX, nextPunch = 0, angle = 0 }
			out("ZA WARUDO! Circling " .. victim.Name .. " until they're dead")
		else
			out("Za Warudo: say 'za warudo <player>' with a player in the server")
		end
		return
	end

	-- Star Finger: "star finger <player>"
	local _, sfEnd = text:find(SF_PATTERN)
	if sfEnd then
		local name = text:sub(sfEnd + 1):match("(%S+)")
		name = name and name:gsub("[%.,!%?:;]+$", "")
		local victim = name and name ~= "" and findPlayerByName(name, state.target)
		if victim then
			state.move = { kind = "starfinger", sf = true, victim = victim, untilT = os.clock() + SF_MAX, nextPunch = 0, nextShot = 0 }
			out("STAR FINGER! Targeting " .. victim.Name)
		else
			out("Star Finger: say 'star finger <player>' with a player in the server")
		end
		return
	end

	for _, move in ipairs(MOVES) do
		local n = countMatches(text, move.patterns)
		if n > 0 then
			-- while Za Warudo / Star Finger is running only "return" / "recall" can interrupt it
			if state.move and (state.move.zw or state.move.sf) and move.kind ~= "cancel" then return end
			if move.kind == "barrage" then
				local dur = math.clamp(n * BARRAGE_PER_WORD, BARRAGE_MIN, BARRAGE_MAX)
				if state.move and state.move.kind == "barrage" then
					-- chanting more extends the barrage instead of restarting it
					state.move.untilT = math.max(state.move.untilT, os.clock() + dur)
				else
					state.move = { kind = "barrage", untilT = os.clock() + dur, nextPunch = 0 }
				end
			elseif move.kind == "punch" then
				state.move = { kind = "punch", untilT = os.clock() + 0.5, nextPunch = 0, single = true }
			elseif move.kind == "cancel" then
				state.move = nil
			end
			return
		end
	end
end

-- Where the stand stands during a move: on the ground, in front of the stand user, facing their way
local function movePosition(char, hum, tRoot, tChar)
	local flat = CFrame.new(tRoot.Position) * CFrame.Angles(0, math.atan2(-tRoot.CFrame.LookVector.X, -tRoot.CFrame.LookVector.Z), 0)
	local front = (flat * CFrame.new(0, 0, -FRONT_DISTANCE)).Position
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char, tChar }
	local hit = workspace:Raycast(front + Vector3.new(0, 6, 0), Vector3.new(0, -60, 0), params)
	local groundY = hit and hit.Position.Y or (tRoot.Position.Y - 3)
	local root = char:FindFirstChild("HumanoidRootPart")
	-- Height of the root part above the ground when standing. R6 has no HipHeight (legs are 2 studs long and
	-- the root is 2 tall, so the root sits 3 up); R15 is HipHeight plus half the root's height.
	local height
	if hum.RigType == Enum.HumanoidRigType.R6 then
		height = 3
	else
		height = hum.HipHeight + (root and root.Size.Y / 2 or 1)
	end
	height = height + 0.2 -- a little clearance so feet never clip the floor
	return CFrame.new(front.X, groundY + height, front.Z) * (flat - flat.Position)
end

local function startStand(target)
	stopStand()
	state.target = target
	local mirrors = {} -- [target's AnimationTrack] = our copy
	state.mirrors = mirrors
	local lastHum
	local spawnT = 0 -- when the current character spawned
	local punchSeen = {} -- [their AnimationTrack] = true while a punch animation of theirs is playing

	if HELP_ON_START then
		task.delay(1, function()
			if state.target == target then whisperHelp(target) end
		end)
	end

	-- Listen to what the stand user says (same source the quizbot uses)
	state.chatConns = {}
	local okTCS = pcall(function()
		return TextChatService.ChatVersion == Enum.ChatVersion.TextChatService
	end) and TextChatService.ChatVersion == Enum.ChatVersion.TextChatService
	if okTCS then
		table.insert(state.chatConns, TextChatService.MessageReceived:Connect(function(msg)
			local src = msg.TextSource
			if src and src.UserId == target.UserId then
				handleChat(msg.Text)
			end
		end))
	else
		table.insert(state.chatConns, target.Chatted:Connect(handleChat))
	end

	state.conn = RunService.Heartbeat:Connect(function(dt)
		local tChar = target.Character
		local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
		local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
		local char = lplr.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not (tRoot and tHum and root and hum) then
			return
		end

		-- autoc4 is teleporting you to the C4 giver and back: hands off until it's done
		if type(_G.DeemBusy) == "table" and _G.DeemBusy.autoc4 then
			return
		end

		-- A Deem command the stand user ran has your character: hands off until it finishes
		local cmd = state.cmd
		if cmd then
			if cmd.spec.running() then
				return
			end
			out(cmd.name .. " finished - following again")
			state.cmd = nil
			state.move = nil
			state.inMove, state.exitUntil = true, nil -- glide back to their side
		end

		-- New character (respawn): old copies belonged to the old one
		if hum ~= lastHum then
			lastHum = hum
			spawnT = os.clock()
			for _, m in pairs(mirrors) do pcall(function() m:Destroy() end) end
			table.clear(mirrors)
		end

		-- Criminal + forcefield and they're inside the prison: wait here until it's safe
		-- Same timing problem as returnbydeath: right after a respawn the team and forcefield show up a moment late,
		-- so "no forcefield" can't be trusted yet. Keep waiting through a short grace period, and only call it
		-- clear once the forcefield has stayed gone for FF_STABLE seconds (stops the waiting/following flicker).
		local blocked = shouldWait(char, tRoot)
		if not blocked and inPrison(tRoot.Position) and os.clock() - spawnT < FF_APPEAR_GRACE then
			local team = lplr.Team
			if team == nil or (team.Name == "Criminals" and not char:FindFirstChildOfClass("ForceField")) then
				blocked = true
			end
		end
		if blocked then
			state.clearSince = nil
		elseif state.waiting then
			state.clearSince = state.clearSince or os.clock()
			if os.clock() - state.clearSince < FF_STABLE then blocked = true end
		end
		if blocked then
			if not state.waiting then
				state.waiting = true
				out("Waiting - you're a Criminal with a forcefield and " .. target.Name .. " is in the prison")
			end
			return
		elseif state.waiting then
			state.waiting = false
			out("Forcefield gone / target left the prison - following")
		end

		-- A move in progress: drop to the ground in front of them and punch, then fall back to following
		-- Their punch animation started: punch along with them (once per play of the animation)
		local seenNow = {}
		for _, track in ipairs(tHum:GetPlayingAnimationTracks()) do
			local id = track.Animation and track.Animation.AnimationId or ""
			for _, punchId in ipairs(PUNCH_ANIMS) do
				if string.find(id, punchId, 1, true) then
					seenNow[track] = true
					if not punchSeen[track] then
						punchSeen[track] = true
						if not state.move then
							-- fast = no gliding: snap in front of them and punch on the very same frame
							state.move = { kind = "punch", untilT = os.clock() + 0.4, nextPunch = 0, single = true, fast = true }
						elseif state.move.single then
							state.move.untilT = os.clock() + 0.4
							state.move.nextPunch = 0 -- another punch from them: another punch from us
						end
					end
				end
			end
		end
		for track in pairs(punchSeen) do
			if not seenNow[track] then punchSeen[track] = nil end
		end

		local move = state.move
		if move and os.clock() > move.untilT then
			state.move = nil
			move = nil
		end
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero

		-- Star Finger ended (target down, "return", timeout): take the silentgun grip off the Remington
		if state.sf and not (move and move.sf and move.mode == "gun") then
			sfCleanup()
		end

		if move then
			state.inMove, state.exitUntil = true, nil
			if not move.started then
				move.started = true
				move.glideEnd = os.clock() + GLIDE_MAX
				-- stop the copied animations so our own punch animation can play
				for _, m in pairs(mirrors) do pcall(function() m:Stop(0) m:Destroy() end) end
				table.clear(mirrors)
			end
			-- ZA WARUDO: orbit the named victim at top speed, hitting every step, until they're dead
			if move.zw then
				local v = move.victim
				if not validVictim(v, target) then
					out("Za Warudo over - " .. (v and v.Name or "target") .. " is down")
					state.move = nil
					return
				end
				local vRoot = v.Character.HumanoidRootPart
				move.angle = (move.angle or 0) + ZW_SPEED * dt
				local pos = vRoot.Position + Vector3.new(math.cos(move.angle), 0, math.sin(move.angle)) * ZW_RADIUS
				root.CFrame = CFrame.lookAt(pos, Vector3.new(vRoot.Position.X, pos.Y, vRoot.Position.Z))
				if os.clock() >= move.nextPunch then
					move.nextPunch = os.clock() + ZW_HIT_INTERVAL
					hit(v, hum)
				end
				return
			end
			-- STAR FINGER: same team = kill aura, different team = shoot them with the Remington
			if move.sf then
				local v = move.victim
				if not validVictim(v, target) then
					out("Star Finger over - " .. (v and v.Name or "target") .. " is down")
					state.move = nil
					return
				end
				local vChar = v.Character
				local vRoot = vChar.HumanoidRootPart
				-- pick the method from the teams + Hostile / Trespassing, and re-check as those change
				if os.clock() >= (move.nextDecide or 0) then
					move.nextDecide = os.clock() + SF_RECHECK
					local want, why = sfDecide(v)
					if want == "gun" and move.noGun then want = "melee" end -- we already failed to get a gun
					if want ~= move.mode then
						move.mode = want
						-- show exactly what was read, so a wrong attribute name / location is easy to spot
						why = why .. " [team " .. teamName(v) .. ", Hostile=" .. tostring(flag(v, "Hostile")) .. ", Trespassing=" .. tostring(flag(v, "Trespassing")) .. ", you are " .. teamName(lplr) .. "]"
						if want == "gun" then
							out(v.Name .. " is " .. why .. " - shooting them")
						elseif want == "melee" then
							out(v.Name .. " is " .. why .. " - using the kill aura")
						elseif want == "arrest" then
							out(v.Name .. " is " .. why .. " - arresting them")
						end
					end
				end
				-- Guard and the target is neither killable nor arrestable: say so and stop
				if move.mode == "deny" then
					out("Star Finger: " .. v.Name .. " is not a Criminal, Hostile or Trespassing")
					say(SF_DENY_MESSAGE)
					state.move = nil
					return
				end
				-- Guard and the target is Trespassing: arrest them (same call arrestall uses)
				if move.mode == "arrest" then
					local vc = vChar
					if vc:GetAttribute("Arrested") then
						out("Arrested " .. v.Name)
						pcall(function() hum:UnequipTools() end)
						state.move = nil
						return
					end
					local cuffs = char:FindFirstChild("Handcuffs")
					if not cuffs then
						local bp = lplr:FindFirstChildWhichIsA("Backpack")
						local inBag = bp and bp:FindFirstChild("Handcuffs")
						if inBag then
							pcall(function() hum:EquipTool(inBag) end)
						else
							out("No Handcuffs found - are you a Guard?")
							state.move = nil
						end
						return
					end
					root.CFrame = vRoot.CFrame + ARREST_OFFSET -- the remote only works within about 8 studs
					-- a forcefield protects them: hold here until it drops
					if vc:FindFirstChildOfClass("ForceField") then return end
					if not move.arresting and os.clock() >= (move.nextArrest or 0) then
						move.arrestTries = (move.arrestTries or 0) + 1
						if move.arrestTries > ARREST_MAX_TRIES then
							out("Couldn't arrest " .. v.Name .. " (server answered: " .. tostring(move.lastRes) .. ")")
							pcall(function() hum:UnequipTools() end)
							state.move = nil
							return
						end
						move.arresting = true
						move.nextArrest = os.clock() + ARREST_INTERVAL
						task.spawn(function()
							local remotes = ReplicatedStorage:FindFirstChild("Remotes")
							local remote = remotes and remotes:FindFirstChild("ArrestPlayer")
							if not remote then
								out("Couldn't find the ArrestPlayer remote")
								if state.move == move then state.move = nil end
								return
							end
							local ok, res = pcall(function() return remote:InvokeServer(v, 1) end)
							move.lastRes = ok and tostring(res) or ("error: " .. tostring(res))
							move.arresting = false
							if ok and res then
								out("Arrested " .. v.Name)
								pcall(function() hum:UnequipTools() end)
								if state.move == move then state.move = nil end
							end
						end)
					end
					return
				end
				local tool
				if move.mode == "gun" then
					tool = getRemington()
					if not tool then
						if move.fetching then
							root.CFrame = CFrame.new(SF_GUN_SPOT)
							return
						elseif not move.fetched then
							out("No " .. SF_GUN_NAME .. " - teleporting to get one")
							fetchRemington(move)
							root.CFrame = CFrame.new(SF_GUN_SPOT)
							return
						end
						out("Couldn't get a " .. SF_GUN_NAME .. " - using the kill aura instead")
						move.mode = "melee"
						move.noGun = true
					end
				end
				if move.mode == "gun" then
					-- equip it and give it the silentgun grip
					if tool.Parent ~= char then pcall(function() hum:EquipTool(tool) end) end
					if tool.Parent == char then
						local sf = state.sf
						if not sf or sf.tool ~= tool then
							sf = { tool = tool, origGrip = tool.GripPos }
							state.sf = sf
						end
						if tool.GripPos ~= SILENT_GRIP then tool.GripPos = SILENT_GRIP end
					end
					-- stand where there is a clear line to them; if a wall is in the way, move behind the target
					local spots = sfSpots(vRoot, tRoot)
					if os.clock() >= (move.nextSpotCheck or 0) then
						move.nextSpotCheck = os.clock() + 0.1
						local up = Vector3.new(0, 1.5, 0)
						local cur = move.slot and spots[move.slot]
						if not (cur and clearShot(cur.Position + up, vChar, char)) then
							local pick
							for i, s in ipairs(spots) do
								if clearShot(s.Position + up, vChar, char) then pick = i break end
							end
							pick = pick or 2 -- nowhere is clear: behind the target
							if pick ~= move.slot then
								if move.slot then out("Wall in the way - " .. SF_SPOT_NAMES[pick]) end
								move.slot = pick
							end
						end
					end
					root.CFrame = spots[move.slot or 1]
					-- shoot
					if tool.Parent == char and os.clock() >= move.nextShot then
						move.nextShot = os.clock() + SF_SHOT_INTERVAL
						local head = vChar:FindFirstChild("Head") or vRoot
						pcall(function()
							ReplicatedStorage.GunRemotes.ShootEvent:FireServer({
								{ root.Position, head.Position, head },
							})
						end)
					end
					return
				end
				-- kill aura on a team mate (or when no gun could be had)
				root.CFrame = victimPosition(vRoot, tRoot)
				if os.clock() >= move.nextPunch then
					move.nextPunch = os.clock() + PUNCH_INTERVAL
					hit(v, hum)
				end
				return
			end
			-- glide down in front of them (tracks them live, so it stays smooth if they move)
			-- pick (or re-pick) the victim: the first player in front of the stand user
			move.startT = move.startT or os.clock()
			-- single punches scan every frame until they find someone; barrages rescan on an interval
			if not validVictim(move.victim, target) and (move.single or os.clock() >= (move.nextScan or 0)) then
				move.nextScan = os.clock() + RESCAN_INTERVAL
				move.victim = findVictim(char, tChar, tRoot, target)
				if move.victim then out("Attacking " .. move.victim.Name) end
			end
			local victim = validVictim(move.victim, target) and move.victim or nil
			local vRoot = victim and victim.Character.HumanoidRootPart
			local function goal()
				if vRoot then return victimPosition(vRoot, tRoot) end
				return movePosition(char, hum, tRoot, tChar)
			end
			if move.fast and not move.arrived then
				move.arrived = true
				root.CFrame = goal()
			end
			if not move.arrived then
				if glideTo(root, goal(), dt) or os.clock() > move.glideEnd then
					move.arrived = true
				else
					return
				end
			end
			root.CFrame = goal()
			-- a single punch waits briefly for a victim instead of wasting its one shot on the air
			local waiting = move.single and not victim and (os.clock() - move.startT) < 0.2
			if os.clock() >= move.nextPunch and not waiting then
				move.nextPunch = os.clock() + PUNCH_INTERVAL
				if victim then
					hit(victim, hum)
				else
					out("Nobody in front of " .. target.Name .. " - punching the air")
					pressPunch() -- nobody in front of them: punch the air like before
				end
				if move.single then move.nextPunch = math.huge end -- one punch, then hold the pose until untilT
			end
			return
		end
		if state.inMove then
			-- the move just ended: glide back up to their side, then carry on following normally
			state.exitUntil = state.exitUntil or (os.clock() + GLIDE_MAX)
			if glideTo(root, tRoot.CFrame * OFFSET, dt) or os.clock() > state.exitUntil then
				state.inMove, state.exitUntil = false, nil
			else
				return
			end
		end
		root.CFrame = tRoot.CFrame * OFFSET

		-- Copy animations: start copies of new tracks, keep speed / weight / time in sync, drop finished ones
		local playing = {}
		for _, track in ipairs(tHum:GetPlayingAnimationTracks()) do
			local animId = track.Animation and track.Animation.AnimationId or ""
			if not string.find(animId, SKIP_ANIM) then
				playing[track] = true
				local copy = mirrors[track]
				if not copy then
					local ok, loaded = pcall(function() return hum:LoadAnimation(track.Animation) end)
					if ok and loaded then
						copy = loaded
						mirrors[track] = copy
						copy.Priority = track.Priority
						copy.Looped = track.Looped
						copy:Play(0.05, math.max(track.WeightCurrent, 0.01), track.Speed)
						copy.TimePosition = track.TimePosition
					end
				end
				if copy then
					if not copy.IsPlaying then
						copy:Play(0.05, math.max(track.WeightCurrent, 0.01), track.Speed)
					end
					copy:AdjustSpeed(track.Speed)
					copy:AdjustWeight(math.max(track.WeightCurrent, 0.01), 0)
					if math.abs(copy.TimePosition - track.TimePosition) > 0.1 then
						copy.TimePosition = track.TimePosition
					end
				end
			end
		end
		for track, copy in pairs(mirrors) do
			if not playing[track] then
				pcall(function() copy:Stop(0.05) copy:Destroy() end)
				mirrors[track] = nil
			end
		end

		-- Stop our own animations (the default walk / idle) so only the copied ones show
		local ours = {}
		for _, copy in pairs(mirrors) do ours[copy] = true end
		for _, t in ipairs(hum:GetPlayingAnimationTracks()) do
			if not ours[t] then
				t:Stop(0)
			end
		end
	end)
end

Commands.stand = function(arg)
	local name = arg and tostring(arg)
	if name and name:lower() == "stop" then
		if state.conn then
			stopStand()
			return out("Stand stopped")
		end
		return out("No stand is active")
	end
	if not name then
		if state.conn then
			stopStand()
			return out("Stand stopped")
		end
		return out("Usage: stand <player>")
	end

	local target = findPlayer(name)
	if not target then
		return out("No player found for '" .. name .. "'")
	end
	startStand(target)
	out("Now " .. target.Name .. "'s stand (run 'stand stop' to stop)")
end
end
--// Loader + runners \\-------------------------------------------------------------

-- Everything registered so far is built in; files in Deem_commands only add commands that aren't built in
-- (so an old copy of tpbomb.lua etc. in the folder can never replace the merged versions).
for name in pairs(Commands) do D.builtin[name] = true end

function D.loadExternal()
	if not (isfolder and makefolder and listfiles and readfile) then return end
	if not isfolder(CommandsDirectory) then pcall(makefolder, CommandsDirectory) end
	local okList, files = pcall(listfiles, CommandsDirectory)
	if not okList then return end
	for _, filePath in ipairs(files) do
		local fileName = filePath:match("[^\\/]+%.lua$") or filePath:match("[^\\/]+%.txt$")
		if fileName then
			local commandName = fileName:sub(1, #fileName - 4):lower()
			if D.builtin[commandName] then
				-- built in already: skip silently
			else
				local call, err = loadstring(readfile(filePath))
				if not call then
					warn("Failed to load command:", filePath, "Error:", err)
				else
					local success, fn = pcall(call)
					if success and type(fn) == "function" then
						Commands[commandName] = fn
					else
						warn("Command script must return a function:", filePath)
					end
				end
			end
		end
	end
end

local loadOk, loadErr = pcall(D.loadExternal)
if not loadOk then
	warn("Deem Admin: could not load custom commands:", loadErr)
end

local function split(str, sep)
	local out = {}
	for token in string.gmatch(str, "[^" .. sep .. "]+") do
		table.insert(out, token)
	end
	return out
end

local function runLine(line, feedback)
	local args = split(line, " ")
	if #args == 0 then return end
	local commandName = resolveCommand(table.remove(args, 1))
	local fn = Commands[commandName]
	if not fn then
		return feedback("Unknown command: " .. commandName)
	end
	local success, err = pcall(fn, table.unpack(args))
	if success then
		feedback("Executed '" .. commandName .. "' successfully!")
	else
		feedback("Error executing '" .. commandName .. "': " .. tostring(err))
	end
end

-- Chat command runner  (;command args)
local function processChatMessage(message)
	if message:sub(1, #ChatPrefix) == ChatPrefix then
		runLine(message:sub(#ChatPrefix + 1), sendChatFeedback)
	end
end

-- Command bar runner
local function processInputCommand(cmd)
	runLine(cmd, sendOutputFeedback)
end

-- Press ; to focus the command bar
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.Semicolon then
		Input:CaptureFocus()
		task.defer(function() Input.Text = "" end)
	end
end)

Input.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		processInputCommand(Input.Text)
		Input.Text = ""
	end
end)

plr.Chatted:Connect(processChatMessage)
