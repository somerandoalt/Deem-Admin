-- hug / closehug / kiss (one engine) ---------------------------------------------------
-- Loop-teleports (zero delay) in front of / behind a player, facing them, and loop-plays animations.
do
	local out = D.logger("pose")
	local ACTION, ACTION2, MOVEMENT = Enum.AnimationPriority.Action, Enum.AnimationPriority.Action2, Enum.AnimationPriority.Movement
	-- hug: looped hug + head tilt on top. kiss: played like Infinite Yield's ;anim (Movement priority, not forced to loop).
	local POSES = {
		hug = {
			verb = "Hugging", defaultDistance = 1.3,
			anims = {
				{ id = "rbxassetid://159223413", priority = ACTION, loop = true },
				{ id = "rbxassetid://283545583", priority = ACTION2, loop = true },
			},
		},
		kiss = {
			verb = "Kissing", defaultDistance = 1,
			anims = {
				{ id = "rbxassetid://159223413", priority = MOVEMENT },
				{ id = "rbxassetid://187951261", priority = MOVEMENT },
				{ id = "rbxassetid://283545583", priority = MOVEMENT, optional = "tilt" },
				{ id = "rbxassetid://116690317", priority = MOVEMENT, optional = "hug" },
			},
		},
	}

	-- One state for all of them: starting one stops the other (they'd fight over your position otherwise)
	local pose = _G.DeemPose
	if type(pose) ~= "table" then
		pose = {}
		_G.DeemPose = pose
	end

	local function stopPose()
		if pose.conn then pose.conn:Disconnect() pose.conn = nil end
		for _, t in ipairs(pose.tracks or {}) do pcall(function() t:Stop() t:Destroy() end) end
		for _, a in ipairs(pose.anims or {}) do pcall(function() a:Destroy() end) end
		pose.tracks, pose.anims, pose.active, pose.kind = nil, nil, nil, nil
	end

	local function startPose(kind, target, distance, side, flags)
		stopPose()
		pose.kind = kind
		pose.anims, pose.active = {}, {}
		for _, info in ipairs(POSES[kind].anims) do
			if not info.optional or flags[info.optional] then
				local a = Instance.new("Animation")
				a.AnimationId = D.anim2track(info.id)
				table.insert(pose.anims, a)
				table.insert(pose.active, info)
			end
		end
		local lastHum
		local hum0 = getHum()
		if hum0 and hum0.SeatPart then hum0.Sit = false end -- unseat first so a seat can't hold us back

		pose.conn = RunService.Heartbeat:Connect(function()
			local char, hum, root = D.getMe()
			local _, _, tRoot = D.getParts(target)
			if not (char and tRoot) then return end
			if D.ffGate(tRoot.Position, out) then return end -- Criminal + forcefield and they're in the prison

			local sign = (side == "back") and -1 or 1
			local front = tRoot.Position + tRoot.CFrame.LookVector * distance * sign
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			root.CFrame = CFrame.lookAt(front, Vector3.new(tRoot.Position.X, front.Y, tRoot.Position.Z))

			if hum ~= lastHum then -- (re)load the animations on a new character
				lastHum = hum
				for _, t in ipairs(pose.tracks or {}) do pcall(function() t:Destroy() end) end
				pose.tracks = {}
				local animator = D.getAnimator(hum)
				for i, a in ipairs(pose.anims) do
					local ok, track = pcall(function() return animator:LoadAnimation(a) end)
					if ok and track then
						track.Priority = pose.active[i].priority
						if pose.active[i].loop then track.Looped = true end
						pose.tracks[i] = track
					end
				end
			end
			for _, track in pairs(pose.tracks or {}) do
				if not track.IsPlaying then track:Play(0.1) end
			end
		end)
	end

	local function poseCommand(kind, label, defaultDistance, ...)
		local args = { ... }
		local name = args[1] and tostring(args[1])
		if not name or name:lower() == "stop" then
			if pose.conn then
				stopPose()
				return out("Stopped")
			end
			return out(name and "Nothing is running"
				or ("Usage: " .. label .. " <player> [front|back] [distance]" .. (kind == "kiss" and " [tilt] [hug]" or "") .. " | " .. label .. " stop"))
		end
		local target = D.findPlayer(name)
		if not target then return out("No player found for '" .. name .. "'") end
		local side, distance, flags = "front", defaultDistance, {}
		for i = 2, #args do
			local a = tostring(args[i]):lower()
			if a == "front" or a == "back" then
				side = a
			elseif kind == "kiss" and (a == "tilt" or a == "headtilt") then
				flags.tilt = true
			elseif kind == "kiss" and a == "hug" then
				flags.hug = true
			elseif tonumber(a) then
				distance = math.clamp(tonumber(a), 0.5, 10)
			end
		end
		startPose(kind, target, distance, side, flags)
		out(POSES[kind].verb .. " " .. target.Name .. " from the " .. side .. (flags.tilt and " with a head tilt" or "")
			.. " (run '" .. label .. " stop' to stop)")
	end

	Commands.hug = function(...) poseCommand("hug", "hug", POSES.hug.defaultDistance, ...) end
	Commands.closehug = function(...) poseCommand("hug", "closehug", 1, ...) end -- same as hug, closer by default
	Commands.kiss = function(...) poseCommand("kiss", "kiss", POSES.kiss.defaultDistance, ...) end

	D.poseRunning = function(kind) return pose.conn ~= nil and pose.kind == kind end
end

-- autoc4 -------------------------------------------------------------------------------
-- Grabs a new C4 every time you use one up, then puts you straight back where you were.
do
	local out = D.logger("autoc4")
	local GONE_FOR, CHECK_INTERVAL = 0.1, 0.1
	local state = _G.DeemAutoC4
	if type(state) ~= "table" then
		state = { enabled = false, loopId = 0, grabbing = false }
		_G.DeemAutoC4 = state
	end

	local function grabAndReturn()
		local char, _, root = D.getMe()
		if not root then return false end
		local home = char:GetPivot()
		out("C4 used up - grabbing a new one")
		local got = D.grabC4(out)
		D.waitForForcefield(function() return home.Position end, nil, out) -- going home could be into the prison
		local c, _, r = D.getMe()
		if c and r then
			for _ = 1, 3 do -- hold our speed at zero for a few frames so nothing carries us off
				r.AssemblyLinearVelocity = Vector3.zero
				r.AssemblyAngularVelocity = Vector3.zero
				c:PivotTo(home)
				RunService.Heartbeat:Wait()
			end
		end
		out(got and "Got a new C4 - back where you were" or "Couldn't pick up a C4")
		return got
	end

	local function watch(id)
		local hadC4, goneSince, lastChar = false, nil, nil
		while state.enabled and state.loopId == id do
			local ok, err = pcall(function()
				local char = D.getMe()
				if lplr.Character ~= lastChar then -- respawn: the old C4 went with the old character
					lastChar = lplr.Character
					hadC4, goneSince = false, nil
				end
				if not char then
					hadC4, goneSince = false, nil -- dead / respawning
				elseif D.getC4() then
					if not hadC4 then out("Watching your C4 - it will grab a new one when it's used up") end
					hadC4, goneSince = true, nil
				elseif type(_G.DeemBusy) == "table" and _G.DeemBusy.tpbomb == true then
					goneSince = nil -- let the bomb command finish its trip first
				elseif hadC4 then
					goneSince = goneSince or os.clock()
					if os.clock() - goneSince >= GONE_FOR then
						goneSince = nil
						state.grabbing = true
						D.setBusy("autoc4", true) -- the stand holds off while we're teleporting around
						local okGrab, err2 = pcall(grabAndReturn)
						D.setBusy("autoc4", false)
						state.grabbing = false
						if not okGrab then out("Error: " .. tostring(err2)) end
						hadC4 = D.getC4() ~= nil
					end
				end
			end)
			if not ok then out("Error: " .. tostring(err)) end
			task.wait(CHECK_INTERVAL)
		end
	end

	Commands.autoc4 = function(arg)
		local a = arg and tostring(arg):lower()
		local want = (a == "on") or (a ~= "off" and not state.enabled)
		state.loopId += 1 -- stops any loop that's already running
		state.enabled = want
		if want then
			task.spawn(watch, state.loopId)
			out("ON - after you use up a C4 it will grab a new one and bring you back (run 'autoc4' again to stop)")
			if not D.getC4() then out("You don't have a C4 yet - it starts watching once you do (tpbomb gets you one)") end
		else
			out("OFF")
		end
	end
end

-- arrestall ----------------------------------------------------------------------------
-- Teleports to every Criminal (except your Roblox friends) and arrests them, then goes back.
do
	local out = D.logger("arrestall")
	local ARREST_COOLDOWN, TRY_INTERVAL, MAX_TRIES, MAX_WAIT, TASE_WAIT = 7, 0.1, 25, 90, 0.6
	local STAND_OFFSET = Vector3.new(3, 1, 0)
	local VOID_Y = math.max(workspace.FallenPartsDestroyHeight + 150, -400)
	local busy, cancelled = false, false
	local skipped = {}

	local function isCriminal(p) return p ~= lplr and p.Team and p.Team.Name == "Criminals" end
	local function targetRoot(p)
		local r, c = select(3, D.getParts(p)), p.Character
		local h = c and c:FindFirstChildOfClass("Humanoid")
		if r and h and h.Health > 0 then return r, c end
	end
	-- A criminal with a forcefield can't be arrested: wait until it's gone before going after them
	local function isProtected(p)
		local r, c = targetRoot(p)
		return r ~= nil and c:FindFirstChildOfClass("ForceField") ~= nil
	end
	local function nextTarget()
		local _, _, myRoot = D.getMe()
		local best, bestDist, waiting = nil, nil, 0
		for _, p in ipairs(Players:GetPlayers()) do
			if isCriminal(p) and not D.isFriend(p) and not skipped[p] then
				local r, c = targetRoot(p)
				if r and not c:GetAttribute("Arrested") then
					if isProtected(p) then
						waiting += 1
					else
						local d = myRoot and (r.Position - myRoot.Position).Magnitude or 0
						if not bestDist or d < bestDist then best, bestDist = p, d end
					end
				end
			end
		end
		return best, waiting
	end
	local function equip(name)
		local char, hum = D.getMe()
		if not hum then return nil end
		local tool = char:FindFirstChild(name)
		if tool and tool:IsA("Tool") then return tool end
		local bp = lplr:FindFirstChildWhichIsA("Backpack")
		tool = bp and bp:FindFirstChild(name)
		if tool and tool:IsA("Tool") then
			hum:EquipTool(tool)
			return tool
		end
	end
	-- Handcuffs must actually be in the character (equipping takes a moment), or the server ignores the arrest
	local function holdCuffs()
		local tool = equip("Handcuffs")
		if not tool then return nil end
		local t = os.clock()
		while tool.Parent ~= lplr.Character and os.clock() - t < 1 do task.wait() end
		return tool.Parent == lplr.Character and tool or nil
	end
	-- Like a zero-delay loopgoto: snaps to the target every frame so a moving target can't get away
	local followConn
	local function followStart(p)
		if followConn then followConn:Disconnect() end
		followConn = RunService.Heartbeat:Connect(function()
			local _, _, myRoot = D.getMe()
			local r = targetRoot(p)
			if myRoot and r then
				myRoot.AssemblyLinearVelocity = Vector3.zero
				myRoot.CFrame = r.CFrame + STAND_OFFSET
			end
		end)
	end
	local function followStop()
		if followConn then followConn:Disconnect() followConn = nil end
	end

	local function run(useTase)
		local remote = D.remote("ArrestPlayer")
		if not remote then return 0, "Couldn't find the ArrestPlayer remote" end
		local char = D.getMe()
		if not char then return 0, "Your character isn't ready" end
		if lplr.Team and lplr.Team.Name ~= "Guards" then
			out("Warning: you're on " .. lplr.Team.Name .. ", the server probably only lets Guards arrest")
		end
		local home = char:GetPivot()
		local arrested, nextArrestAt = 0, 0
		table.clear(skipped)
		local waitStart, announcedWait = os.clock(), false

		while not cancelled do
			local _, _, myRoot = D.getMe()
			if not myRoot then
				task.wait(0.5)
			elseif myRoot.Position.Y < VOID_Y then
				out("Stopped: you fell below the map")
				break
			elseif os.clock() < nextArrestAt then
				task.wait(0.1) -- the game makes you wait after each arrest
			else
				local target, waiting = nextTarget()
				if not target then
					if waiting > 0 and os.clock() - waitStart < MAX_WAIT then
						if not announcedWait then
							announcedWait = true
							out("Waiting for " .. waiting .. " criminal(s) with a forcefield to lose it")
						end
						task.wait(0.25)
					else
						break
					end
				else
					waitStart, announcedWait = os.clock(), false
					local cuffs = holdCuffs()
					if not cuffs then
						out("No Handcuffs found in your inventory - are you a Guard?")
						break
					end
					local lc = lplr.Character
					local lastPos = lc and lc:GetPivot() or home -- we come back here after this arrest
					followStart(target)
					local lastRes, tries, done, taseTried = nil, 0, false, false
					while not cancelled and not done and tries < MAX_TRIES do
						local r, c = targetRoot(target)
						if not r or not isCriminal(target) or c:GetAttribute("Arrested") or isProtected(target) then break end
						if useTase and not taseTried and not c:GetAttribute("Tased") then
							taseTried = true
							local taser = equip("Taser")
							if taser then
								pcall(function() taser:Activate() end)
								task.wait(TASE_WAIT)
								cuffs = holdCuffs() or cuffs
							end
						end
						if os.clock() >= nextArrestAt then
							tries += 1
							local ok, res = pcall(function() return remote:InvokeServer(target, 1) end)
							lastRes = ok and tostring(res) or ("error: " .. tostring(res))
							if ok and res then
								arrested += 1
								nextArrestAt = os.clock() + ARREST_COOLDOWN
								out("Arrested " .. target.Name)
								done = true
							end
						end
						task.wait(TRY_INTERVAL)
					end
					followStop()
					local c2 = lplr.Character
					if c2 and c2:FindFirstChild("HumanoidRootPart") then
						c2.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
						pcall(function() c2:PivotTo(lastPos) end)
					end
					if not done then
						local _, c = targetRoot(target)
						if not (c and c:GetAttribute("Arrested")) and isCriminal(target) and not isProtected(target) then
							skipped[target] = true
							out("Couldn't arrest " .. target.Name .. ", skipping (server answered: " .. tostring(lastRes) .. ")")
						end
					end
				end
			end
		end
		followStop()
		local c = lplr.Character
		if c and c:FindFirstChild("HumanoidRootPart") then pcall(function() c:PivotTo(home) end) end
		return arrested
	end

	Commands.arrestall = function(...)
		local arg = ({ ... })[1] and tostring(({ ... })[1]):lower()
		if arg == "stop" then
			if busy then
				cancelled = true
				return out("Stopping...")
			end
			return out("Nothing is running")
		end
		if busy then return out("Already running, use 'arrestall stop' to stop it") end
		busy, cancelled = true, false
		task.spawn(function()
			local ok, n, err = pcall(run, arg == "tase")
			if not ok then out("Error: " .. tostring(n))
			elseif err then out(err)
			else out("Finished: " .. tostring(n) .. " arrested") end
			busy, cancelled = false, false
		end)
	end
end

-- tpbomb / autotpbomb (one bomb routine) -----------------------------------------------
-- tpbomb <player>        one bomb: grab C4, place it under them, jump 80+ studs away, detonate, come back
-- autotpbomb <player>    the same over and over (waits out forcefields, hops team if you share theirs)
-- Both: "<cmd> stop" stops it.
do
	local out = D.logger("tpbomb")
	local PLACE_SETTLE, PLACE_TRIES, PLACE_RETRY_WAIT = 0.15, 6, 0.12
	local SAFE_DISTANCE = 80 -- the blast is well inside this
	local STAND_OFFSET = Vector3.zero -- directly inside the target so no wall can block the placement

	local state = _G.DeemTpBomb
	if type(state) ~= "table" then
		state = { busy = false, cancelled = false, mode = nil }
		_G.DeemTpBomb = state
	end
	local cancelled = function() return state.cancelled end

	local function bombPosition(obj, fallback)
		if typeof(obj) == "Instance" then
			if obj:IsA("BasePart") then return obj.Position end
			if obj:IsA("Model") then return obj:GetPivot().Position end
		end
		return fallback
	end

	-- Somewhere at least SAFE_DISTANCE from the bomb: home if far enough, else the C4 giver, else high in the air
	local function goSafe(bombPos, home)
		local c, _, r = D.getMe()
		if not r then return false end
		local candidates = {
			{ pos = home.Position },
			{ pos = D.GIVER_POS },
			{ pos = bombPos + Vector3.new(0, 300, 0), air = true },
			{ pos = bombPos + Vector3.new(500, 300, 0), air = true },
		}
		local chosen, farthest, farthestD
		for _, cand in ipairs(candidates) do
			local d = (cand.pos - bombPos).Magnitude
			if d >= SAFE_DISTANCE and not D.ffBlocks(cand.pos) then
				chosen = cand
				break
			end
			if not farthestD or d > farthestD then farthest, farthestD = cand, d end
		end
		chosen = chosen or farthest
		r.AssemblyLinearVelocity = Vector3.zero
		r.AssemblyAngularVelocity = Vector3.zero
		if chosen.air then r.Anchored = true end
		c:PivotTo(CFrame.new(chosen.pos))
		return true
	end

	local function unanchor()
		local char = lplr.Character
		local r = char and char:FindFirstChild("HumanoidRootPart")
		if r then pcall(function() r.Anchored = false end) end
	end

	-- Sticks us to the target every frame (zero-delay loopgoto)
	local followConn
	local function followStart(target)
		if followConn then followConn:Disconnect() end
		followConn = RunService.Heartbeat:Connect(function()
			local _, _, myRoot = D.getMe()
			local _, _, tr = D.getParts(target)
			if myRoot and tr then
				myRoot.AssemblyLinearVelocity = Vector3.zero
				myRoot.CFrame = tr.CFrame + STAND_OFFSET
			end
		end)
	end
	local function followStop()
		if followConn then followConn:Disconnect() followConn = nil end
	end

	-- One full cycle. Returns true, or false + the reason.
	local function bombOnce(target)
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		local c4remotes = remotes and remotes:FindFirstChild("C4")
		local activate = c4remotes and c4remotes:FindFirstChild("ActivateC4")
		if not activate then return false, "Couldn't find the C4 remotes" end

		local char, _, root = D.getMe()
		if not root then return false, "Your character isn't ready" end
		local home = char:GetPivot()

		local function bail(why)
			followStop()
			unanchor()
			pcall(function() D.unequip() end)
			local c = lplr.Character
			if c then pcall(function() c:PivotTo(home) end) end
			return false, why
		end

		if not D.getC4() and not D.grabC4(out) then return bail("Couldn't pick up a C4") end
		if not D.equipC4() then return bail("Couldn't equip the C4") end

		local _, _, tRoot = D.getParts(target)
		if not tRoot then return bail(target.Name .. " has no character") end

		-- Criminal + forcefield and the target is in the prison: wait for the forcefield to drop first
		D.waitForForcefield(function()
			local _, _, tr = D.getParts(target)
			return tr and tr.Position
		end, cancelled, out)

		local _, _, r = D.getMe()
		if not r then return false, "You died" end
		r.AssemblyLinearVelocity = Vector3.zero
		followStart(target)
		task.wait(PLACE_SETTLE) -- let the server see where we are

		local _, _, tr0 = D.getParts(target)
		if not tr0 then return bail(target.Name .. " left / died") end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { lplr.Character, target.Character }
		local floorPos = tr0.Position - Vector3.new(0, 3, 0)

		-- The server rejects a placement if it hasn't caught up with where you are yet, so retry with fresh positions
		local ok, placed, bombObj
		for attempt = 1, PLACE_TRIES do
			local _, _, r2 = D.getMe()
			local _, _, tr2 = D.getParts(target)
			if not (r2 and tr2) then break end
			if attempt > 1 then task.wait(PLACE_RETRY_WAIT) end
			local ray = workspace:Raycast(tr2.Position, Vector3.new(0, -30, 0), params)
			floorPos = ray and ray.Position or (tr2.Position - Vector3.new(0, 3, 0))
			local origin = tr2.Position -- we're sitting on them, so this is their position
			ok, placed, bombObj = pcall(function() return activate:InvokeServer(origin, floorPos) end)
			if ok and placed then break end
		end
		if not ok or not placed then
			return bail("The server didn't let the C4 be placed (" .. tostring(placed) .. ")")
		end
		followStop()

		-- GET AWAY FIRST, then detonate from a safe distance so the blast can never reach you
		local placedBomb = (typeof(bombObj) == "Instance" and bombObj) or workspace:FindFirstChild("ServerC4")
		local bombPos = bombPosition(placedBomb, floorPos)
		goSafe(bombPos, home)

		local exploded = false
		local function fire()
			task.spawn(function() pcall(function() activate:InvokeServer() end) end)
		end
		local started, lastReequip = os.clock(), 0
		while os.clock() - started < 6 do
			local _, _, mr = D.getMe()
			if not mr then break end
			if (mr.Position - bombPos).Magnitude < SAFE_DISTANCE then
				goSafe(bombPos, home) -- somehow too close: move away, and don't detonate this frame
			else
				fire() -- sent every frame instead of waiting on each answer
				if placedBomb and not placedBomb.Parent then
					exploded = true
					break
				end
				if not placedBomb and os.clock() - started > 1 then break end
			end
			-- It tends to go off after a fresh re-equip, so cycle the tool quickly while still firing
			if os.clock() - lastReequip > 0.08 then
				lastReequip = os.clock()
				local _, hum = D.getMe()
				local tool = D.getC4()
				if hum and tool then
					if tool.Parent == lplr.Character then
						hum:UnequipTools()
					else
						hum:EquipTool(tool)
						pcall(function() tool:Activate() end)
					end
				end
			end
			RunService.Heartbeat:Wait()
		end
		out(exploded and ("Detonated C4 on " .. target.Name)
			or ("Sent the detonate call " .. (placedBomb and "but the bomb is still there" or "(couldn't track the bomb)")))

		task.wait(0.1)
		unanchor()
		D.unequip()
		D.waitForForcefield(function() return home.Position end, cancelled, out) -- going home could be into the prison
		local c = lplr.Character
		if c then pcall(function() c:PivotTo(home) end) end
		return true
	end

	-- Team hopping (autotpbomb) ---------------------------------------------------------
	local teamCooldown = 0
	local function pickTeam(button)
		if teamCooldown < os.clock() then
			pcall(function() firesignal(button.MouseButton1Click) end)
			teamCooldown = os.clock() + 0.1
		end
	end
	-- Joins any team button that isn't the target's team. Returns true if our team changed.
	local function hopTeam(avoid)
		local pg = lplr:FindFirstChild("PlayerGui")
		local gui = pg and pg:FindFirstChild("TeamsFrame", true)
		if not gui then
			out("Couldn't find the team picker (TeamsFrame)")
			return false
		end
		local avoidName = avoid and avoid.Name:lower() or nil
		local preferred, fallback = {}, {}
		for _, holder in ipairs(gui:GetChildren()) do
			local btn = holder:FindFirstChild("Button")
			if btn and btn.AutoButtonColor then
				-- The label says "Guard" / "Inmate" while the teams are "Guards" / "Inmates": compare both directions
				local isAvoid = false
				if avoidName then
					for _, d in ipairs(holder:GetDescendants()) do
						if d:IsA("TextLabel") or d:IsA("TextButton") then
							local text = d.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
							if #text >= 3 and (avoidName:find(text, 1, true) or text:find(avoidName, 1, true)) then
								isAvoid = true
							end
						end
					end
				end
				table.insert(isAvoid and fallback or preferred, btn)
			end
		end
		for _, btn in ipairs(fallback) do table.insert(preferred, btn) end

		local before = lplr.Team
		for _, btn in ipairs(preferred) do
			if state.cancelled then return false end
			pickTeam(btn)
			local t = os.clock()
			while lplr.Team == before and os.clock() - t < 3 do task.wait(0.1) end
			if lplr.Team ~= before and lplr.Team ~= avoid then
				local w = os.clock() -- a team change comes with a respawn
				while not D.getMe() and os.clock() - w < 10 do task.wait(0.2) end
				return true
			end
			before = lplr.Team
		end
		return false
	end

	local function runAuto(target)
		local lastMsg, bombs = nil, 0
		local function say(msg)
			if msg ~= lastMsg then lastMsg = msg out(msg) end
		end
		while not state.cancelled do
			if not target.Parent then
				say(target.Name .. " left the game")
				break
			end
			if lplr.Team == nil or lplr.Team.Name == "Neutral" or (target.Team ~= nil and lplr.Team == target.Team) then
				say("Same team as " .. target.Name .. " - switching team")
				if not hopTeam(target.Team) then
					say("Couldn't switch teams, retrying")
					task.wait(1)
				end
			else
				local tChar, tHum, tRoot = D.getParts(target)
				if not (tRoot and tHum) or tHum.Health <= 0 then
					say("Waiting for " .. target.Name .. " to respawn")
					task.wait(0.5)
				elseif tChar:FindFirstChildOfClass("ForceField") then
					say("Waiting for " .. target.Name .. "'s forcefield to drop")
					task.wait(0.25)
				elseif not D.getMe() then
					task.wait(0.5)
				else
					lastMsg = nil
					local ok, why = bombOnce(target)
					if ok then
						bombs += 1
						task.wait(0.3)
					else
						say("Bomb failed: " .. tostring(why))
						task.wait(1)
					end
				end
			end
		end
		return bombs
	end

	local function start(mode, ...)
		local name = ({ ... })[1] and tostring(({ ... })[1])
		if name and name:lower() == "stop" then
			if state.busy then
				state.cancelled = true
				return out("Stopping...")
			end
			return out("Nothing is running")
		end
		if not name then return out("Usage: " .. mode .. " <player> | " .. mode .. " stop") end
		if state.busy then return out("Already running (" .. tostring(state.mode) .. "), use '" .. state.mode .. " stop' to stop it") end
		local target = D.findPlayer(name)
		if not target then return out("No player found for '" .. name .. "'") end

		state.busy, state.cancelled, state.mode = true, false, mode
		D.setBusy("tpbomb", true) -- autoc4 and the stand hold off while this runs
		if mode == "autotpbomb" then out("Bombing " .. target.Name .. " until you run 'autotpbomb stop'") end
		task.spawn(function()
			local ok, res
			if mode == "autotpbomb" then
				ok, res = pcall(runAuto, target)
				if ok then out("Stopped after " .. tostring(res) .. " bomb" .. (res == 1 and "" or "s")) end
			else
				ok, res = pcall(function()
					local good, why = bombOnce(target)
					if not good then out(tostring(why)) end
				end)
			end
			if not ok then out("Error: " .. tostring(res)) end
			followStop()
			unanchor()
			state.busy, state.cancelled, state.mode = false, false, nil
			D.setBusy("tpbomb", false)
		end)
	end

	Commands.tpbomb = function(...) start("tpbomb", ...) end
	Commands.autotpbomb = function(...) start("autotpbomb", ...) end
	D.bombRunning = function() return state.busy end
end

-- ufo ----------------------------------------------------------------------------------
-- Takes a car and hovers it over a player, then (when you say so) lowers onto them and carries them to the sky / void.
--   ufo <player>  |  ufo void|sky [speed] [lowerSpeed]  |  ufo stop
do
	local out = D.logger("ufo")
	local HOVER_HEIGHT, HOVER_TIME = 30, 1.5
	local DEFAULT_SPEED, DEFAULT_LOWER = 80, 8
	local VOID_Y, SKY_Y = -500, 500
	local MAX_RETRIES, JOB_TIMEOUT, SPIN_SPEED = 6, 180, 12

	local state = _G.DeemUfo
	if type(state) ~= "table" then
		state = { busy = false, cancelled = false }
		_G.DeemUfo = state
	end
	local cancelled = function() return state.cancelled end

	local function run(target)
		if lplr.Team == nil or lplr.Team.Name == "Neutral" then
			return out("Pick a team first - you can't spawn cars while on the Neutral team")
		end
		local char = D.getMe()
		if not char then return out("Your character isn't ready") end
		local home = char:GetPivot()
		local function goHome() pcall(function() (lplr.Character or char):PivotTo(home) end) end

		out("Getting a car...")
		local car, why = D.spawnCar(out, cancelled)
		if not car then
			goHome()
			return out(why or "Couldn't get a car")
		end
		local body = car:WaitForChild("Body", 5)
		local driver = body and body:WaitForChild("VehicleSeat", 5)
		local passSeat = body and body:FindFirstChild("Seat")
		if not (driver and passSeat) then
			goHome()
			return out("The car has no driver / passenger seat")
		end
		-- The driver seat is what gives us control of the car
		if not D.sitIn(driver, 3) then
			goHome()
			return out("Couldn't sit in the car")
		end
		local wheels = car:FindFirstChild("Wheels") -- wheels make the car tilt and bounce
		if wheels then pcall(function() wheels:Destroy() end) end

		-- The seats are welded, so this offset never changes; we set the car's exact CFrame every frame from it
		local driverRel = passSeat.CFrame:ToObjectSpace(driver.CFrame)
		local yaw, lastSpin = 0, os.clock()
		local function placeSeat(pos)
			local now = os.clock()
			yaw = (yaw + SPIN_SPEED * (now - lastSpin)) % (math.pi * 2)
			lastSpin = now
			driver.CFrame = (CFrame.new(pos) * CFrame.Angles(0, yaw, 0)) * driverRel
			driver.AssemblyLinearVelocity = Vector3.zero
			driver.AssemblyAngularVelocity = Vector3.zero
		end
		local function targetInCar()
			local _, th = select(2, D.getParts(target))
			return th and th.SeatPart and th.SeatPart:IsDescendantOf(car)
		end

		out("Hovering over " .. target.Name .. " - run 'ufo void' or 'ufo sky' to pick them up")
		local phase, h, hoverUntil = "hover", HOVER_HEIGHT, 0
		local mode, speed, lowerSpeed
		state.order = nil
		local retries, start = 0, os.clock()
		local carryPos, result

		while not result do
			local dt = RunService.Heartbeat:Wait()
			local _, myHum = D.getMe()
			if state.cancelled then result = "stopped"
			elseif mode and os.clock() - start > JOB_TIMEOUT then result = "timed out"
			elseif not car.Parent or not driver.Parent then result = "the car was deleted"
			elseif not myHum then result = "you died"
			elseif myHum.SeatPart ~= driver then result = "you were knocked out of the car"
			else
				local _, tHum, tRoot = D.getParts(target)
				if not tRoot or not tHum or tHum.Health <= 0 then
					result = target.Name .. " left / died"
				elseif D.ffGate(tRoot.Position, out) then
					driver.AssemblyLinearVelocity = Vector3.zero -- hold the car still until the forcefield is gone
					driver.AssemblyAngularVelocity = Vector3.zero
				elseif phase == "hover" then
					placeSeat(tRoot.Position + Vector3.new(0, h, 0))
					if state.order and not mode then
						mode, speed, lowerSpeed = state.order.mode, state.order.speed, state.order.lowerSpeed
						hoverUntil = os.clock() + HOVER_TIME
						start = os.clock()
						out("Going for " .. target.Name .. " (" .. mode .. ")")
					end
					if mode and os.clock() >= hoverUntil then phase = "lower" end
				elseif phase == "lower" then
					h -= lowerSpeed * dt
					placeSeat(tRoot.Position + Vector3.new(0, h, 0))
					if targetInCar() then
						phase, carryPos = "carry", passSeat.Position
						out(target.Name .. " is in the car - carrying them " .. (mode == "void" and "to the void" or "to the sky"))
					elseif h < -2 then -- missed: go back up and try again
						retries += 1
						if retries > MAX_RETRIES then
							result = "couldn't get " .. target.Name .. " into the car"
						else
							phase, h, hoverUntil = "hover", HOVER_HEIGHT * 0.5, os.clock() + 0.5
						end
					end
				elseif phase == "carry" then
					if not targetInCar() then
						phase, h, hoverUntil = "hover", HOVER_HEIGHT * 0.5, os.clock() + 0.5
					else
						local destY = mode == "void" and VOID_Y or SKY_Y
						local y = carryPos.Y
						y = y + math.clamp(destY - y, -speed * dt, speed * dt)
						carryPos = Vector3.new(carryPos.X, y, carryPos.Z)
						placeSeat(carryPos)
						if y == destY then result = "done" end
					end
				end
			end
		end

		D.standUp() -- the target stays in the car at the destination
		goHome()
		if result == "done" then
			out("Delivered " .. target.Name .. " to Y = " .. (mode == "void" and VOID_Y or SKY_Y))
		else
			out("Stopped: " .. result)
		end
	end

	Commands.ufo = function(...)
		local args = { ... }
		local first = args[1] and tostring(args[1])
		if first and first:lower() == "stop" then
			if state.busy then
				state.cancelled = true
				return out("Stopping...")
			end
			return out("Nothing is running")
		end
		if not first then return out("Usage: ufo <player>, then ufo void / ufo sky") end
		local low = first:lower()
		if low == "void" or low == "sky" then
			if not state.busy then return out("Start it first with: ufo <player>") end
			if state.order then return out("Already going for them") end
			state.order = {
				mode = low,
				speed = math.clamp(tonumber(args[2]) or DEFAULT_SPEED, 1, 2000),
				lowerSpeed = math.clamp(tonumber(args[3]) or DEFAULT_LOWER, 0.5, 200),
			}
			return
		end
		if state.busy then return out("Already running, use 'ufo stop' to stop it") end
		local target = D.findPlayer(first)
		if not target then return out("No player found for '" .. first .. "'") end

		state.busy, state.cancelled, state.order = true, false, nil
		task.spawn(function()
			local paused = D.pauseAntiSit()
			local ok, err = pcall(run, target)
			if not ok then out("Error: " .. tostring(err)) end
			D.resumeAntiSit(paused)
			state.busy, state.cancelled, state.order = false, false, nil
		end)
	end
	D.ufoRunning = function() return state.busy end
end

-- spamcars -----------------------------------------------------------------------------
-- Spawns cars from EVERY "Car Spawner" and brings each one to you (or to another player). Cars only, no passengers.
--   spamcars [count] [player] [existing|new|all] | spamcars test[N] | spamcars stop
do
	local out = D.logger("spamcars")
	local MAX_CARS, TEST_DELETIONS, PILE_SKIP_RADIUS, GIVE_UP_AFTER, SIT_TIMEOUT = 500, 3, 70, 30, 2
	local VOID_Y = math.max(workspace.FallenPartsDestroyHeight + 150, -400)

	local state = _G.DeemSpamcars
	if type(state) ~= "table" then
		state = { busy = false, cancelled = false }
		_G.DeemSpamcars = state
	end
	local cancelled = function() return state.cancelled end

	-- Sits in the car (so we control it), moves it to `drop`, and gets out
	local function bringCar(car, drop)
		local _, hum = D.getMe()
		if not hum then return false, "your character isn't ready" end
		local body = car:WaitForChild("Body", 5)
		local seat = body and body:WaitForChild("VehicleSeat", 5)
		if not seat then return false, "the car has no driver seat" end

		D.waitForForcefield(function() return seat.Position end, cancelled, out) -- car may be inside the prison
		if state.cancelled then return false, "stopped" end
		if not D.sitIn(seat, SIT_TIMEOUT) then
			return false, seat.Parent and "couldn't sit in the car" or "the car was deleted"
		end
		D.waitForForcefield(function() return drop.Position end, cancelled, out)
		car:PivotTo(drop) -- we're seated, so the car moves with us and we control it
		task.wait(0.1)
		seat.AssemblyLinearVelocity = Vector3.zero
		seat.AssemblyAngularVelocity = Vector3.zero
		D.standUp()
		return true
	end

	local function run(count, followPlayer, mode, testTarget)
		local remote = D.remote("InteractWithItem")
		local container = workspace:FindFirstChild("CarContainer")
		if not (remote and container) then out("Couldn't find the car remote / CarContainer") return 0 end
		if D.isNeutral(lplr) then out("Pick a team first - you can't spawn cars while on the Neutral team") return 0 end
		local spawners = D.getSpawners()
		if #spawners == 0 and mode ~= "existing" then out("No parts named 'Car Spawner' found") return 0 end
		local myChar = D.getMe()
		if not myChar then out("Your character isn't ready") return 0 end
		local home = myChar:GetPivot()

		out("Using " .. #spawners .. " car spawner" .. (#spawners == 1 and "" or "s") .. ", bringing cars to "
			.. (followPlayer and (followPlayer.Name .. "'s location") or "your location") .. " (run 'spamcars stop' to stop)")

		local made, failures, lastMade, stopReason = 0, 0, os.clock(), nil
		local handled = {} -- cars already dealt with: never grabbed twice

		-- Spreads cars around the target in a golden-angle spiral so they don't stack on one spot
		local function dropCFrame(index)
			local base = home
			if followPlayer then
				local _, _, r = D.getParts(followPlayer)
				if not r then return nil end
				base = r.CFrame
			end
			local slot = index % 40
			local angle = slot * 2.399963
			local radius = math.min(60, 8 + 2.5 * math.sqrt(slot))
			return CFrame.new(base.Position) * CFrame.new(math.cos(angle) * radius, 4, math.sin(angle) * radius)
		end

		local function noteFailure(prefix, err)
			failures += 1
			if failures <= 3 then out(prefix .. tostring(err)) end
		end

		-- Grabs cars that exist right now (not occupied, not already in the pile). Returns a stop reason or nil.
		local function grabExisting()
			local _, _, pr = followPlayer and D.getParts(followPlayer)
			local pileBase = pr and pr.Position or home.Position
			local _, _, myRoot = D.getMe()
			local mePos = myRoot and myRoot.Position or home.Position
			local existing = {}
			for _, car in ipairs(container:GetChildren()) do
				local seat = car:FindFirstChild("Body") and car.Body:FindFirstChild("VehicleSeat")
				if seat and not handled[car] and not seat.Occupant and (seat.Position - pileBase).Magnitude > PILE_SKIP_RADIUS then
					table.insert(existing, car)
				end
			end
			table.sort(existing, function(a, b)
				return (a:GetPivot().Position - mePos).Magnitude < (b:GetPivot().Position - mePos).Magnitude
			end)
			if #existing > 0 then out("Grabbing " .. #existing .. " existing car" .. (#existing == 1 and "" or "s")) end
			for _, car in ipairs(existing) do
				handled[car] = true
				if state.cancelled then return "stopped" end
				if made >= count then return "done" end
				local _, _, r = D.getMe()
				if r and r.Position.Y < VOID_Y then return "you fell below the map" end
				local seat = car.Parent and car:FindFirstChild("Body") and car.Body:FindFirstChild("VehicleSeat")
				if seat and not seat.Occupant then
					local drop = dropCFrame(made)
					if not drop then return "the player you're bringing cars to is gone" end
					local ok, err = bringCar(car, drop)
					if ok then made += 1 lastMade = os.clock() else noteFailure("Couldn't bring an existing car: ", err) end
				end
			end
		end

		-- TEST MODE: wait for the server to wipe the cars, then spawn and count how many it deletes
		local testStats
		if testTarget then
			mode = "new"
			local removedTimes = {}
			local removeConn = container.ChildRemoved:Connect(function() table.insert(removedTimes, os.clock()) end)
			out("TEST: waiting for the server to wipe the cars... (run 'spamcars stop' to cancel)")
			local waitStart, hadCars, wiped = os.clock(), #container:GetChildren() > 0, false
			while not wiped and not state.cancelled do
				task.wait(0.1)
				if #container:GetChildren() > 0 then hadCars = true end
				local recent = 0
				for _, t in ipairs(removedTimes) do
					if os.clock() - t <= 3 then recent += 1 end
				end
				if (hadCars and #container:GetChildren() == 0 and #removedTimes > 0) or recent >= 5 then wiped = true end
			end
			if state.cancelled then
				removeConn:Disconnect()
				stopReason = "stopped"
			else
				out("TEST: the server wiped the cars after " .. string.format("%.1f", os.clock() - waitStart)
					.. "s - spawning now, will stop after " .. testTarget .. " get deleted")
				table.clear(removedTimes)
				testStats = { conn = removeConn, times = removedTimes, started = os.clock() }
			end
		end

		if mode ~= "new" and not stopReason then
			stopReason = grabExisting()
			if mode == "existing" and not stopReason then stopReason = "done" end
		end

		while not stopReason do
			local brought = false
			for _, spawner in ipairs(spawners) do
				if state.cancelled then stopReason = "stopped" break end
				if made >= count then stopReason = "done" break end
				if testStats and #testStats.times >= testTarget then stopReason = "test finished" break end
				local _, _, root = D.getMe()
				if not root then
					task.wait(0.5) -- respawning
				elseif root.Position.Y < VOID_Y then
					stopReason = "you fell below the map"
					break
				else
					local car = D.spawnAt(spawner, remote, container) -- (cooldown: just move on to the next spawner)
					if car then
						handled[car] = true
						local drop = dropCFrame(made)
						if not drop then stopReason = "the player you're bringing cars to is gone" break end
						local ok, err = bringCar(car, drop)
						if ok then made += 1 brought = true lastMade = os.clock() else noteFailure("Couldn't bring a car: ", err) end
					end
				end
			end
			-- "all": between rounds also pick up any other cars that showed up
			if not stopReason and mode == "all" then stopReason = grabExisting() end
			if not stopReason then
				if os.clock() - lastMade > GIVE_UP_AFTER then
					stopReason = "no car was brought for " .. GIVE_UP_AFTER .. "s"
				elseif not brought then
					task.wait(0.1) -- every spawner is on cooldown: don't spin
				end
			end
		end

		if testStats then
			testStats.conn:Disconnect()
			local n = #testStats.times
			local firstAt = testStats.times[1] and (testStats.times[1] - testStats.started)
			local lastAt = testStats.times[n] and (testStats.times[n] - testStats.started)
			out("TEST RESULT: brought " .. made .. " car" .. (made == 1 and "" or "s") .. ", the server deleted " .. n
				.. (firstAt and (" (first after " .. string.format("%.1f", firstAt) .. "s, last after " .. string.format("%.1f", lastAt) .. "s)") or ""))
			if stopReason == "test finished" then stopReason = "done" end
		end

		D.standUp()
		D.waitForForcefield(function() return home.Position end, cancelled, out)
		local c = lplr.Character
		if c and c:FindFirstChild("HumanoidRootPart") then pcall(function() c:PivotTo(home) end) end
		if stopReason ~= "done" and stopReason ~= "stopped" then out("Stopped: " .. stopReason) end
		return made
	end

	Commands.spamcars = function(...)
		local count, followName, mode, testTarget = MAX_CARS, nil, "both", nil
		for _, a in ipairs({ ... }) do
			local low = tostring(a):lower()
			if low == "stop" then
				if state.busy then
					state.cancelled = true
					return out("Stopping...")
				end
				return out("Nothing is running")
			end
			local n = tonumber(a)
			if low:match("^test%d*$") then
				testTarget = tonumber(low:match("%d+")) or TEST_DELETIONS
			elseif low == "existing" or low == "new" or low == "all" then
				mode = low
			elseif n then
				count = math.clamp(math.floor(n), 1, MAX_CARS)
			else
				followName = tostring(a)
			end
		end
		if state.busy then return out("Already running, use 'spamcars stop' to stop it") end
		local followPlayer
		if followName then
			followPlayer = D.findPlayer(followName)
			if not followPlayer then return out("No player found for '" .. followName .. "'") end
		end
		state.busy, state.cancelled = true, false
		task.spawn(function()
			local paused = D.pauseAntiSit()
			local ok, made = pcall(run, count, followPlayer, mode, testTarget)
			if not ok then out("Error: " .. tostring(made)) made = 0 end
			D.resumeAntiSit(paused)
			out("Finished: " .. tostring(made) .. " car" .. (made == 1 and "" or "s") .. " brought")
			state.busy, state.cancelled = false, false
		end)
	end
end

-- Shared car-fling rig (forcecrim + carbring) ---------------------------------------------
-- You stand at a car spawner and keep spawning cars; every car you control is slammed into the current target
-- every frame (Vape FlingExploit method). Getting control of the cars is done in 3 steps, automatically:
--   1) raise your simulation radius so the server hands you nearby unanchored parts
--   2) if that isn't enough: sit in each new car for a moment and get out again
--   3) if control is lost as soon as you get out: stay seated and fling from inside the car
-- D.startCarRig(opt) -> rig { setTarget(p), hits(), ejects(), riding(), stop() }  or  nil + reason
--   opt.say = log function, opt.carCap = stop pressing the spawner at this many cars (nil = no cap)
do
	local SPAWN_PROTECTION = 2
	local APPROACH_STEP = 2.4 -- radians the approach side rotates each frame (cycles all sides)
	local STILL_SPEED = 3
	local APPROACH_RADII = { 1, 4, 8, 12 }
	local RAM_SPEED = 10000
	local RAM_OFFSET = CFrame.new(-2, 0, -1)
	local CLAIM_FALLBACK_AFTER, NO_CARS_WARNING = 1.5, 6
	local SIM_RADIUS = 1e9
	local TRACK_WINDOW, TRACK_BASE_LEAD, TRACK_PING_SCALE, TRACK_MAX_LEAD, TRACK_MAX_SPEED = 0.12, 0.08, 1.5, 0.5, 250
	local CAR_SPAWN_CFRAME = CFrame.new(-525.802612, 54.7750854, 1774.31689)
	local BUTTON_RANGE, SPAWN_INTERVAL = 15, 0.1
	local VOID_Y = math.max(workspace.FallenPartsDestroyHeight + 150, -400)
	D.VOID_Y = VOID_Y
	D.CAR_SPAWN_CFRAME = CAR_SPAWN_CFRAME

	local learned = { sitClaim = false, rideOnly = false } -- kept between runs so we don't re-discover it each time

	local function linkPhysics(seat, rootPart)
		pcall(function()
			if sethiddenproperty then
				sethiddenproperty(seat, "PhysicsRepRootPart", rootPart)
				if InstanceHandle then sethiddenproperty(seat, "PhysicsRepRootRef", InstanceHandle.new(rootPart)) end
			end
		end)
	end
	local function getPing()
		local ok, ping = pcall(function() return lplr:GetNetworkPing() end)
		return (ok and type(ping) == "number") and ping or 0.05
	end
	local function boostSimulation()
		pcall(function() if setsimulationradius then setsimulationradius(SIM_RADIUS, SIM_RADIUS) end end)
		pcall(function() if sethiddenproperty then sethiddenproperty(lplr, "SimulationRadius", SIM_RADIUS) end end)
		pcall(function() lplr.MaximumSimulationRadius = SIM_RADIUS end)
	end
	D.boostSimulation = boostSimulation

	-- The known-good spawner first, else every "Car Spawner" on the map
	local function spawnerList()
		local spawners = D.getSpawners()
		local items = workspace:FindFirstChild("Prison_ITEMS")
		local buttons = items and items:FindFirstChild("buttons")
		local list = buttons and buttons:GetChildren()
		local known = list and list[7] and list[7]:FindFirstChild("Car Spawner")
		if known then
			local idx = table.find(spawners, known)
			if idx then table.remove(spawners, idx) end
			table.insert(spawners, 1, known)
		end
		return spawners
	end

	function D.startCarRig(opt)
		opt = opt or {}
		local say = opt.say or D.logger("carrig")
		local carCap = opt.carCap
		local remote = D.remote("InteractWithItem")
		local container = workspace:FindFirstChild("CarContainer")
		local spawners = spawnerList()
		local button = spawners[1]
		if not (remote and container and button) then return nil, "Couldn't find the car spawner / remote" end
		if D.isNeutral(lplr) then return nil, "Pick a team first - you can't spawn cars while on the Neutral team" end

		local missing = {}
		if not isnetworkowner then table.insert(missing, "isnetworkowner") end
		if not sethiddenproperty then table.insert(missing, "sethiddenproperty") end
		if #missing > 0 then say("Warning: your executor is missing " .. table.concat(missing, " + ") .. " - flings probably won't work") end

		local spawnerIndex, buttonPos, standCFrame = 1, nil, nil
		local function useSpawner(i)
			spawnerIndex = i
			button = spawners[i] or button
			buttonPos = button:IsA("BasePart") and button.Position or button:GetPivot().Position
			standCFrame = (CAR_SPAWN_CFRAME.Position - buttonPos).Magnitude <= BUTTON_RANGE
				and CAR_SPAWN_CFRAME or CFrame.new(buttonPos + Vector3.new(0, 3, 0))
		end
		useSpawner(1)
		if #spawners > 1 then say("Using " .. #spawners .. " car spawners") end

		local seats, fresh, touched, attempted, connections = {}, {}, {}, {}, {}
		local active = true
		local current, curChar, curSeen = nil, nil, 0
		local slams, approach = 0, 0
		local history, histPlayer, histChar = {}, nil, nil
		local claiming, rideSeat = false, nil
		local rideOnly, useSitClaim = learned.rideOnly, learned.sitClaim
		local claimsKept, ejects = 0, 0

		local function owns(seat) return (not isnetworkowner) or isnetworkowner(seat) end

		for _, d in ipairs(container:GetDescendants()) do
			if d:IsA("VehicleSeat") then seats[d] = true end
		end
		table.insert(connections, container.DescendantAdded:Connect(function(inst)
			if inst:IsA("VehicleSeat") then seats[inst] = true fresh[inst] = true end
		end))
		table.insert(connections, container.DescendantRemoving:Connect(function(inst)
			if inst == rideSeat then rideSeat = nil end
			seats[inst], fresh[inst], touched[inst], attempted[inst] = nil, nil, nil, nil
		end))

		-- Every frame: slam the current target with every car we control
		table.insert(connections, RunService.Heartbeat:Connect(function()
			local Player = current
			if not Player then return end
			local char, h, r = D.getParts(Player)
			if not (h and r) or h.Health <= 0 then return end
			if char ~= curChar then curChar, curSeen = char, os.clock() end
			if os.clock() - curSeen < SPAWN_PROTECTION then return end
			if h.SeatPart and h.SeatPart.Anchored then return end

			-- Aim where they're about to be (their velocity is zeroed on our side, so measure it from recent positions)
			local now = os.clock()
			if Player ~= histPlayer or char ~= histChar then
				table.clear(history)
				histPlayer, histChar = Player, char
			end
			table.insert(history, { now, r.Position })
			while #history > 1 and now - history[1][1] > TRACK_WINDOW do table.remove(history, 1) end

			local aim, tgtSpeed = r.Position, 0
			if #history >= 2 then
				local oldest = history[1]
				local dt = now - oldest[1]
				if dt > 0.02 then
					local vel = (r.Position - oldest[2]) / dt
					tgtSpeed = vel.Magnitude
					if tgtSpeed <= TRACK_MAX_SPEED then
						vel = Vector3.new(vel.X, math.clamp(vel.Y, -40, 40), vel.Z)
						aim = r.Position + vel * math.clamp(TRACK_BASE_LEAD + getPing() * TRACK_PING_SCALE, 0, TRACK_MAX_LEAD)
					end
				end
			end

			for seat in pairs(seats) do
				if seat.Parent and (seat == rideSeat or owns(seat)) then
					approach += APPROACH_STEP
					if tgtSpeed < STILL_SPEED and slams % 2 == 0 then
						-- Standing still: the plain Vape hit (fixed spot beside them) is the one that lands
						seat.AssemblyLinearVelocity = Vector3.new(RAM_SPEED, RAM_SPEED, 0)
						seat.CFrame = CFrame.new(aim) * RAM_OFFSET
					else
						-- Come in from a different side and distance every frame, driving through them
						local radius = APPROACH_RADII[(slams % #APPROACH_RADII) + 1]
						local from = aim + CFrame.Angles(0, approach, 0):VectorToWorldSpace(Vector3.new(0, 0, -radius))
						local toward = aim - from
						toward = toward.Magnitude > 0.01 and toward.Unit or Vector3.new(1, 0, 0)
						seat.AssemblyLinearVelocity = Vector3.new(toward.X * RAM_SPEED, RAM_SPEED, toward.Z * RAM_SPEED)
						seat.CFrame = CFrame.lookAt(from, aim + Vector3.new(0.001, 0, 0))
					end
					r.AssemblyLinearVelocity = Vector3.zero
					linkPhysics(seat, r)
					touched[seat] = true
					slams += 1
					local car = seat.Parent and seat.Parent.Parent
					local wheels = car and car:FindFirstChild("Wheels") -- wheels get in the way of the hit
					if wheels then wheels:Destroy() end
				end
			end
		end))

		-- Safety net: we're only meant to move fast while deliberately riding a slammed car
		table.insert(connections, RunService.Heartbeat:Connect(function()
			if not active then return end
			local myChar = lplr.Character
			local rt = myChar and myChar:FindFirstChild("HumanoidRootPart")
			local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
			if not (rt and hum) then return end
			if rideSeat ~= nil or claiming or hum.SeatPart ~= nil then return end
			if rt.AssemblyLinearVelocity.Magnitude > 400 or rt.Position.Y < VOID_Y + 100 then
				rt.AssemblyLinearVelocity = Vector3.zero
				rt.AssemblyAngularVelocity = Vector3.zero
				myChar:PivotTo(standCFrame)
			end
		end))

		-- Out of any seat and back at the spawner, holding speed at zero so nothing inherited from the car carries us off
		local function leaveCar()
			local myChar = lplr.Character
			local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
			if hum then
				local seat = hum.SeatPart
				if seat then -- leaving a seat that's doing 10000 studs/s throws us into the void
					pcall(function()
						seat.AssemblyLinearVelocity = Vector3.zero
						seat.AssemblyAngularVelocity = Vector3.zero
					end)
				end
				hum.Sit = false
				pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
				local t = os.clock()
				while hum.SeatPart and os.clock() - t < 1 do task.wait() end
			end
			if myChar then
				for _ = 1, 6 do
					pcall(function()
						myChar:PivotTo(standCFrame)
						local rt = myChar:FindFirstChild("HumanoidRootPart")
						if rt then
							rt.AssemblyLinearVelocity = Vector3.zero
							rt.AssemblyAngularVelocity = Vector3.zero
						end
					end)
					RunService.Heartbeat:Wait()
				end
			end
		end

		-- Take control of a car by sitting in it
		local function claimSeat(seat)
			claiming = true
			local ok = false
			if D.sitIn(seat, 2) then
				if rideOnly then
					rideSeat, ok = seat, true
					say("Riding a car to fling from inside it")
				else
					local t = os.clock()
					while isnetworkowner and not isnetworkowner(seat) and os.clock() - t < 0.3 do task.wait() end
					local ownedSeated = owns(seat)
					leaveCar()
					task.wait(0.15)
					if owns(seat) then
						claimsKept += 1
						ok = true
						if claimsKept == 1 then say("Took control of a car by sitting in it - control stayed after getting out") end
					else
						rideOnly = true
						learned.rideOnly = true
						attempted[seat] = nil -- try this one again, riding it this time
						say("Control is lost as soon as you get out of a car (while seated you "
							.. (ownedSeated and "did" or "did NOT") .. " control it) - flinging from inside the cars instead")
					end
				end
			end
			if not ok and not rideSeat then leaveCar() end
			claiming = false
		end

		-- Claims new cars by sitting in them (only after simulation radius alone failed)
		task.spawn(function()
			while active do
				if rideSeat then -- a slam knocked us out of the seat: sit straight back in, give the car up only if that keeps failing
					local hum = lplr.Character and lplr.Character:FindFirstChildOfClass("Humanoid")
					if not hum or hum.SeatPart ~= rideSeat then
						local seat, back, t = rideSeat, false, os.clock()
						while active and hum and hum.Health > 0 and seat.Parent and os.clock() - t < 0.6 do
							pcall(function()
								lplr.Character:PivotTo(seat.CFrame)
								seat:Sit(hum)
							end)
							task.wait()
							if hum.SeatPart == seat then back = true break end
						end
						if back then ejects += 1 else rideSeat = nil end
					end
				end
				if useSitClaim and not claiming and (not rideOnly or (current ~= nil and rideSeat == nil)) then
					local pick, pickDist
					local myRoot = lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")
					for seat in pairs(seats) do
						if seat.Parent and fresh[seat] and not attempted[seat] and not seat.Occupant and not owns(seat) then
							local d = myRoot and (seat.Position - myRoot.Position).Magnitude or 0
							if not pickDist or d < pickDist then pick, pickDist = seat, d end
						end
					end
					if pick then
						attempted[pick] = true
						claimSeat(pick)
					end
				end
				task.wait()
			end
		end)

		local function unusedFreshCars()
			local n = 0
			for seat in pairs(fresh) do
				if seat.Parent and not attempted[seat] and not seat.Occupant then n += 1 end
			end
			return n
		end
		local function carCount() return #container:GetChildren() end

		-- Keep pressing the car spawner while we stand next to it
		boostSimulation()
		local lastBoost = os.clock()
		task.spawn(function()
			while active do
				if os.clock() - lastBoost > 1 then
					lastBoost = os.clock()
					boostSimulation()
				end
				if not claiming and not rideSeat then -- don't move us while we sit in a car to claim / ride it
					local myRoot = lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")
					if myRoot then
						if (myRoot.Position - buttonPos).Magnitude > BUTTON_RANGE then
							myRoot.CFrame = standCFrame
							myRoot.AssemblyLinearVelocity = Vector3.zero
						elseif not (useSitClaim and unusedFreshCars() >= 3) and (not carCap or carCount() < carCap) then
							local pressed = button
							task.spawn(function()
								local ok, res = pcall(function() return remote:InvokeServer(pressed) end)
								if ok and res == "Wait for the cooldown" and pressed == button and #spawners > 1 then
									useSpawner(spawnerIndex % #spawners + 1) -- on cooldown: next spawner straight away
									if not claiming and not rideSeat then
										local r2 = lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")
										if r2 then
											r2.CFrame = standCFrame
											r2.AssemblyLinearVelocity = Vector3.zero
										end
									end
								end
							end)
						end
					end
				end
				task.wait(SPAWN_INTERVAL)
			end
		end)

		local function stopCars()
			for seat in pairs(touched) do
				if seat.Parent then
					pcall(function()
						seat.AssemblyLinearVelocity = Vector3.zero
						seat.AssemblyAngularVelocity = Vector3.zero
					end)
				end
			end
		end

		-- Escalate to sitting in cars if simulation radius alone gave nothing, and say what's going on
		local rigStart, warnedNoCars = os.clock(), false
		task.spawn(function()
			while active do
				if current and slams == 0 then
					if not useSitClaim and os.clock() - rigStart > CLAIM_FALLBACK_AFTER then
						useSitClaim = true
						learned.sitClaim = true
						say("No car under your control yet - claiming cars by sitting in them")
					end
					if not warnedNoCars and os.clock() - rigStart > NO_CARS_WARNING then
						warnedNoCars = true
						local total, owned = 0, 0
						for seat in pairs(seats) do
							if seat.Parent then
								total += 1
								if owns(seat) then owned += 1 end
							end
						end
						say("Warning: no car has hit anyone after " .. NO_CARS_WARNING .. "s (cars seen: " .. total
							.. ", under your control: " .. owned .. ", isnetworkowner: " .. tostring(isnetworkowner ~= nil)
							.. ", sethiddenproperty: " .. tostring(sethiddenproperty ~= nil) .. ")")
					end
				end
				task.wait(0.2)
			end
		end)

		local rig = {}
		function rig.setTarget(Player)
			curChar = Player and Player.Character or nil
			curSeen = 0 -- the character we start on has been around long enough
			current = Player
		end
		function rig.hits() return slams end
		function rig.ejects() return ejects end
		function rig.riding() return rideSeat ~= nil or claiming end
		function rig.stopCars() stopCars() end
		function rig.leaveCar() leaveCar() end
		function rig.stop()
			active, current = false, nil
			for _, c in ipairs(connections) do c:Disconnect() end
			stopCars()
			local waited = os.clock()
			while claiming and os.clock() - waited < 3 do task.wait(0.1) end
			if rideSeat or claiming then
				rideSeat = nil
				pcall(leaveCar)
			end
		end
		return rig
	end
end

-- forcecrim ----------------------------------------------------------------------------
-- Flings players with spawned cars until they become Criminals, then stops flinging them.
--   forcecrim <player> [player2 ...] | forcecrim team [teamname] | forcecrim stop
do
	local out = D.logger("forcecrim")
	local CRIM_TEAM, INMATE_TEAM, ONLY_INMATES = "Criminals", "Inmates", true
	local TARGET_TIMEOUT, RESPAWN_WAIT = 30, 10
	local VOID_Y = D.VOID_Y

	local state = _G.DeemForceCrim
	if type(state) ~= "table" then
		state = { busy = false, cancelled = false }
		_G.DeemForceCrim = state
	end
	local function isCriminal(p) return p.Team ~= nil and p.Team.Name == CRIM_TEAM end

	local function skipReason(p)
		local _, hum, root = D.getParts(p)
		if not (hum and root) or hum.Health <= 0 then return "no character or dead" end
		if D.isNeutral(p) then return "on the Neutral team" end
		if isCriminal(p) then return "already a criminal" end
		if ONLY_INMATES and p.Team.Name ~= INMATE_TEAM then return "on " .. p.Team.Name .. ", not " .. INMATE_TEAM end
		if hum.SeatPart and hum.SeatPart.Anchored then return "sitting on an anchored chair" end
	end

	local function runJob(targets)
		local rig, why = D.startCarRig({ say = out })
		if not rig then out(why) return 0 end
		local done = 0
		local function body()
			for _, Player in ipairs(targets) do
				if state.cancelled then break end
				local reason = skipReason(Player)
				if reason then
					out("Skipped " .. Player.Name .. " (" .. reason .. ")")
				else
					out("Flinging " .. Player.Name .. " until they become a criminal")
					rig.setTarget(Player)
					local start, deadSince, result = os.clock(), nil, nil
					local hitsStart = rig.hits()
					local _, _, r0 = D.getParts(Player)
					local startPos, maxMoved = r0 and r0.Position, 0
					while result == nil do
						if state.cancelled then
							result = "cancelled"
						elseif not Player.Parent then
							result = "they left the game"
						elseif isCriminal(Player) then
							result = true
						elseif os.clock() - start > TARGET_TIMEOUT then
							result = "timed out after " .. TARGET_TIMEOUT .. "s, still on " .. D.teamName(Player)
						else
							local myRoot = lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")
							local _, h, r = D.getParts(Player)
							if r and startPos then maxMoved = math.max(maxMoved, (r.Position - startPos).Magnitude) end
							if not myRoot or myRoot.Position.Y < VOID_Y then
								result = "your character is gone or fell below the map"
							elseif not (h and r) or h.Health <= 0 then
								deadSince = deadSince or os.clock()
								if os.clock() - deadSince > RESPAWN_WAIT then result = "they stayed dead" end
							else
								deadSince = nil
								if h.SeatPart and h.SeatPart.Anchored then result = "they sat on an anchored chair" end
							end
						end
						if result == nil then task.wait(0.1) end
					end
					rig.setTarget(nil)
					rig.stopCars()
					if rig.riding() then rig.leaveCar() end
					if result == true then
						done += 1
						out(Player.Name .. " is now a criminal")
					else
						out("Stopped on " .. Player.Name .. " (" .. tostring(result) .. "; car hits: " .. (rig.hits() - hitsStart)
							.. ", target moved up to " .. math.floor(maxMoved) .. " studs, knocked out of the car " .. rig.ejects() .. "x)")
					end
				end
			end
		end
		local okBody, err = pcall(body)
		rig.stop()
		if not okBody then out("Error: " .. tostring(err)) end
		return done
	end

	Commands.forcecrim = function(...)
		local names = { ... }
		if #names == 0 then return out("Usage: forcecrim <player> [player2 ...]  |  forcecrim team [teamname]  |  forcecrim stop") end
		if tostring(names[1]):lower() == "stop" then
			if state.busy then
				state.cancelled = true
				return out("Stopping...")
			end
			return out("Nothing is running")
		end
		if state.busy then return out("Already running, use 'forcecrim stop' to cancel it") end

		local targets, seen = {}, {}
		local function add(p)
			if not seen[p] then seen[p] = true table.insert(targets, p) end
		end
		if tostring(names[1]):lower() == "team" then
			local teamNames = {}
			for i = 2, #names do table.insert(teamNames, names[i]) end
			if #teamNames == 0 then teamNames = { INMATE_TEAM } end
			for _, tn in ipairs(teamNames) do
				local team = D.findTeam(tostring(tn))
				if not team then
					out("No team found for '" .. tostring(tn) .. "'")
				else
					local count = 0
					for _, p in ipairs(Players:GetPlayers()) do
						if p ~= lplr and p.Team == team then add(p) count += 1 end
					end
					if count == 0 then out("No players on team " .. team.Name) end
				end
			end
		else
			for _, n in ipairs(names) do
				local matches = D.findPlayers(tostring(n))
				if #matches == 0 then out("No player found for '" .. tostring(n) .. "'") end
				for _, p in ipairs(matches) do add(p) end
			end
		end
		if #targets == 0 then return end

		local myChar = lplr.Character
		local home = myChar and myChar:FindFirstChild("HumanoidRootPart") and myChar:GetPivot()
		state.busy, state.cancelled = true, false
		D.setBusy("forcecrim", true)
		task.spawn(function()
			local paused = D.pauseAntiSit()
			local ok, done = pcall(runJob, targets)
			if not ok then out("Error: " .. tostring(done)) done = 0 end
			local c = lplr.Character
			if home and c and c:FindFirstChild("HumanoidRootPart") then pcall(function() c:PivotTo(home) end) end
			D.resumeAntiSit(paused)
			out("Finished: " .. tostring(done) .. "/" .. #targets .. " turned criminal")
			state.busy, state.cancelled = false, false
			D.setBusy("forcecrim", false)
		end)
	end
	D.forcecrimRunning = function() return state.busy end
end

-- carbring -----------------------------------------------------------------------------
-- carbring <player> [player2 ...] | carbring team <team> [team2 ...] | carbring stop
-- Brings players to where you stand in a car (3 per trip). Players already sitting in a car are flung instead
-- with the shared car rig (same method as forcecrim).
do
	local out = D.logger("carbring")
	local VOID_Y = D.VOID_Y
	local MAX_TARGET_SPEED, MAX_STEP = 80, 120
	local FLING_TIME, FLING_DONE_SPEED, FLING_JUMP = 20, 10000, 100
	local CAR_CAP, RESCUE_SPEED = 30, 600
	local SIT_TIMEOUT, PASSENGERS_PER_TRIP = 15, 3

	local state = _G.DeemCarBring
	if type(state) ~= "table" then
		state = { busy = false, cancelled = false }
		_G.DeemCarBring = state
	end
	local cancelled = function() return state.cancelled end

	-- Watchdog: while carbring runs, catch us falling toward the void / being thrown and put us back at the last safe spot
	local watch = { conn = nil, lastSafe = nil, ridingFn = nil, rescues = 0 }
	local function startWatchdog()
		if watch.conn then return end
		watch.rescues = 0
		watch.conn = RunService.Heartbeat:Connect(function()
			local char = lplr.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not (root and hum) then return end
			local riding = watch.ridingFn and watch.ridingFn() or false
			local speed = root.AssemblyLinearVelocity.Magnitude
			local inVoid = root.Position.Y < VOID_Y + 100
			local thrown = speed > RESCUE_SPEED and not riding
			if inVoid or thrown then
				if watch.lastSafe then
					watch.rescues += 1
					if watch.rescues == 1 or watch.rescues % 50 == 0 then
						out("Caught you " .. (inVoid and "heading into the void" or "being thrown") .. " - putting you back")
					end
					hum.Sit = false
					root.AssemblyLinearVelocity = Vector3.zero
					root.AssemblyAngularVelocity = Vector3.zero
					char:PivotTo(watch.lastSafe)
				end
			elseif speed < 150 then
				watch.lastSafe = root.CFrame
			end
		end)
	end
	local function stopWatchdog()
		if watch.conn then watch.conn:Disconnect() watch.conn = nil end
		watch.lastSafe, watch.ridingFn = nil, nil
	end

	-- Moves the car onto the target every frame until they sit in any free passenger seat
	local function CarFollow(Car, Player, seats)
		local start = os.clock()
		local lastTick, lastTargetPos = start, nil
		local driverSeat = Car:FindFirstChild("Body") and Car.Body:FindFirstChild("VehicleSeat")
		while os.clock() - start < SIT_TIMEOUT do
			if state.cancelled then return false, "stopped" end
			local nowT = os.clock()
			local frameDt = nowT - lastTick
			lastTick = nowT
			local _, hum, root = D.getParts(Player)
			if not (hum and root) or hum.Health <= 0 then return false, "target died or left" end
			if not Player.Parent then return false, "target left the game" end
			for _, s in ipairs(seats) do
				if hum.SeatPart == s then return true end
			end
			if hum.SeatPart and hum.SeatPart.Anchored then return false, "target sat on an anchored seat" end

			if D.ffGate(root.Position, out) then -- hold until the forcefield is gone (doesn't count against the timeout)
				start += frameDt
				task.wait()
				continue
			end

			local aimSeat
			for _, s in ipairs(seats) do
				if not s.Occupant then aimSeat = s break end
			end
			if not aimSeat then return false, "no free seats left" end
			Car.PrimaryPart = aimSeat

			if root.Position.Y < VOID_Y + 100 then return false, "target is in the void" end
			local myRoot = lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")
			if not myRoot or myRoot.Position.Y < VOID_Y then return false, "you fell below the map" end

			-- A target that is flinging / moving too fast or just jumped a huge distance: hold still instead of chasing
			local jumped = lastTargetPos and (root.Position - lastTargetPos).Magnitude > MAX_STEP
			lastTargetPos = root.Position
			if jumped or root.AssemblyLinearVelocity.Magnitude > MAX_TARGET_SPEED then
				aimSeat.AssemblyLinearVelocity = Vector3.zero
				aimSeat.AssemblyAngularVelocity = Vector3.zero
				task.wait()
				continue
			end

			Car:PivotTo(root.CFrame * CFrame.new(0, -1, 0))
			aimSeat.AssemblyLinearVelocity = Vector3.zero
			aimSeat.AssemblyAngularVelocity = Vector3.zero
			if driverSeat then
				driverSeat.AssemblyLinearVelocity = Vector3.zero -- the seat WE sit in must not build up speed either
				driverSeat.AssemblyAngularVelocity = Vector3.zero
			end
			task.wait()
		end
		return false, "timed out waiting for target to sit"
	end

	local function isInCar(hum)
		local seat = hum.SeatPart
		if not seat then return false end
		if seat:IsA("VehicleSeat") then return true end
		local container = workspace:FindFirstChild("CarContainer")
		return container ~= nil and seat:IsDescendantOf(container)
	end

	-- Fallback fling (no cars available): spin our character inside them. Always puts us back at OrigPiv.
	local function Fling(Player, OrigPiv)
		local myChar, myHum, myRoot = D.getMe()
		if not myRoot then return false end
		local spin = Instance.new("BodyAngularVelocity")
		spin.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
		spin.P = math.huge
		spin.AngularVelocity = Vector3.new(0, 9e5, 0)
		spin.Parent = myRoot
		myHum.PlatformStand = true
		local flung, start, step = false, os.clock(), 0
		while os.clock() - start < FLING_TIME and not state.cancelled do
			local _, hum, root = D.getParts(Player)
			if not (hum and root) or hum.Health <= 0 then break end
			if myRoot.Position.Y < VOID_Y then break end
			local target = hum.SeatPart or root
			step += 1
			myRoot.CFrame = target.CFrame * CFrame.new(0, (step % 2 == 0) and 1.5 or -1.5, 0) -- jitter so the spin keeps connecting
			myRoot.AssemblyLinearVelocity = Vector3.zero
			if target.AssemblyLinearVelocity.Magnitude > FLING_DONE_SPEED or root.AssemblyLinearVelocity.Magnitude > FLING_DONE_SPEED then
				flung = true
				break
			end
			RunService.Heartbeat:Wait()
		end
		spin:Destroy()
		myHum.PlatformStand = false
		for _ = 1, 3 do
			myRoot.AssemblyLinearVelocity = Vector3.zero
			myRoot.AssemblyAngularVelocity = Vector3.zero
			myChar:PivotTo(OrigPiv)
			task.wait(0.05)
		end
		return flung
	end

	-- Flings a target who is in a car with the shared rig. Returns flung, reason, hits, studsMoved (or nil + reason).
	local function CarFling(Player, OrigPiv)
		local rig, rigErr = D.startCarRig({ say = out, carCap = CAR_CAP })
		if not rig then return nil, rigErr end
		watch.ridingFn = rig.riding -- don't "rescue" us from our own ride

		local _, _, startRoot = D.getParts(Player)
		local startPos = startRoot and startRoot.Position
		local lastPos, maxMoved = startPos, 0
		rig.setTarget(Player)

		local flung, reason, start = false, "timed out after " .. FLING_TIME .. "s", os.clock()
		while os.clock() - start < FLING_TIME do
			if state.cancelled then reason = "stopped" break end
			local _, hum, root = D.getParts(Player)
			if not (hum and root) or hum.Health <= 0 then reason = "target died or left" break end
			if not Player.Parent then reason = "target left the game" break end
			local myRoot = lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")
			if not myRoot or myRoot.Position.Y < VOID_Y then reason = "you fell below the map" break end

			-- A hit landed = a big position jump between frames, or a huge speed (their velocity is zeroed on our side)
			local target = hum.SeatPart or root
			if startPos then maxMoved = math.max(maxMoved, (root.Position - startPos).Magnitude) end
			local jumped = lastPos and (root.Position - lastPos).Magnitude > FLING_JUMP
			lastPos = root.Position
			if jumped or target.AssemblyLinearVelocity.Magnitude > FLING_DONE_SPEED or root.AssemblyLinearVelocity.Magnitude > FLING_DONE_SPEED then
				flung, reason = true, nil
				break
			end
			RunService.Heartbeat:Wait()
		end

		local hits = rig.hits()
		rig.stop()
		watch.ridingFn = nil
		local myChar = lplr.Character
		if myChar then
			for _ = 1, 6 do -- back where we started, speed held at zero so nothing inherited from a car carries us off
				pcall(function()
					myChar:PivotTo(OrigPiv)
					local rt = myChar:FindFirstChild("HumanoidRootPart")
					if rt then
						rt.AssemblyLinearVelocity = Vector3.zero
						rt.AssemblyAngularVelocity = Vector3.zero
					end
				end)
				RunService.Heartbeat:Wait()
			end
		end
		return flung, reason, hits, math.floor(maxMoved)
	end

	-- Spawns a car and seats us in the driver seat. Returns { Car, Driver, Seats } or nil + a reason.
	local function getDriverCar(OrigPiv)
		local myChar = D.getMe()
		if not myChar then return nil, "Your character isn't ready" end
		local Car, why = D.spawnCar(out, cancelled)
		if not Car then
			myChar:PivotTo(OrigPiv)
			return nil, why or "Car didn't spawn (timed out)"
		end
		local body = Car:WaitForChild("Body", 5)
		local driverSeat = body and body:WaitForChild("VehicleSeat", 5)
		local passengerSeat = body and body:WaitForChild("Seat", 5)
		if not (driverSeat and passengerSeat) then
			myChar:PivotTo(OrigPiv)
			return nil, "Car is missing its seats"
		end
		task.wait(0.1) -- let the rest of the car finish replicating
		local seats = {}
		for _, d in ipairs(Car:GetDescendants()) do
			if d:IsA("Seat") then table.insert(seats, d) end
		end
		if not table.find(seats, passengerSeat) then table.insert(seats, 1, passengerSeat) end
		-- Sit in the driver seat so we own the car's physics
		if not D.sitIn(driverSeat, 5) then
			(lplr.Character or myChar):PivotTo(OrigPiv)
			return nil, "Couldn't sit in the car"
		end
		return { Car = Car, Driver = driverSeat, Seats = seats }
	end

	-- Skip checks (and in-car flinging) for one target. Returns true if they should be picked up by the car.
	local function prepareTarget(Player)
		local _, hum, root = D.getParts(Player)
		if not (hum and root) or hum.Health <= 0 then
			out("Skipped " .. Player.Name .. " (no character or dead)")
			return false
		end
		D.waitForForcefield(function()
			local _, _, r = D.getParts(Player)
			return r and r.Position
		end, cancelled, out)
		if D.isNeutral(Player) then
			out("Skipped " .. Player.Name .. " (on the Neutral team)")
			return false
		end
		if hum.SeatPart and hum.SeatPart.Anchored then
			out("Skipped " .. Player.Name .. " (sitting on an anchored chair)")
			return false
		end
		if isInCar(hum) then -- in a car: fling them instead of bringing them
			local flingChar = lplr.Character
			if not (flingChar and flingChar:FindFirstChild("HumanoidRootPart")) then
				out("Your character isn't ready")
				return false
			end
			out(Player.Name .. " is in a car, ramming them with cars")
			local origin = flingChar:GetPivot()
			local flung, reason, hits, moved = CarFling(Player, origin)
			if flung == nil then
				out(tostring(reason) .. " - falling back to character fling")
				flung = Fling(Player, origin)
				reason, hits, moved = nil, nil, nil
			end
			if flung then
				out("Flung " .. Player.Name)
			else
				out("Fling on " .. Player.Name .. " didn't land (" .. tostring(reason or "timed out")
					.. (hits and ("; car hits: " .. hits .. ", target moved up to " .. moved .. " studs") or "") .. ")")
			end
			return false
		end
		return true
	end

	-- Brings up to PASSENGERS_PER_TRIP players in ONE car trip. Returns the players that didn't fit.
	local function CarBringGroup(group)
		local leftover = {}
		local myChar, myHum, myRoot = D.getMe()
		if not myRoot then
			out("Your character isn't ready")
			return leftover
		end
		local OrigPiv = myChar:GetPivot()
		local rig, rigErr = getDriverCar(OrigPiv)
		if not rig then
			out(rigErr)
			return leftover
		end
		local Car, driverSeat, seats = rig.Car, rig.Driver, rig.Seats
		local capacity = math.min(#seats, PASSENGERS_PER_TRIP)
		local brought = {}
		for _, Player in ipairs(group) do
			if #brought >= capacity or state.cancelled then
				table.insert(leftover, Player)
			else
				local ok, reason = CarFollow(Car, Player, seats) -- earlier passengers stay seated while we fetch the next
				if ok then table.insert(brought, Player.Name) else out("Failed on " .. Player.Name .. " (" .. tostring(reason) .. ")") end
			end
		end
		if state.cancelled then leftover = {} end
		if #brought > 0 then
			D.waitForForcefield(function() return OrigPiv.Position end, cancelled, out)
			Car.PrimaryPart = driverSeat
			Car:PivotTo(OrigPiv)
			for _, d in ipairs(Car:GetDescendants()) do
				if d:IsA("BasePart") then
					d.AssemblyLinearVelocity = Vector3.zero
					d.AssemblyAngularVelocity = Vector3.zero
				end
			end
			task.wait(0.1)
			out("Brought " .. table.concat(brought, ", "))
		end
		myHum.Sit = false
		task.wait(0.1)
		for _ = 1, 4 do
			myChar:PivotTo(OrigPiv)
			myRoot.AssemblyLinearVelocity = Vector3.zero
			myRoot.AssemblyAngularVelocity = Vector3.zero
			RunService.Heartbeat:Wait()
		end
		return leftover
	end

	Commands.carbring = function(...)
		local names = { ... }
		if #names == 0 then return out("Usage: carbring <player> [player2 ...]  |  carbring team <teamname>  |  carbring stop") end
		if tostring(names[1]):lower() == "stop" then
			if state.busy then
				state.cancelled = true
				return out("Stopping...")
			end
			return out("Nothing is running")
		end
		if state.busy then return out("Already running a car bring, use 'carbring stop' or wait for it to finish") end

		local targets, seen = {}, {}
		local function add(p)
			if not seen[p] then seen[p] = true table.insert(targets, p) end
		end
		if tostring(names[1]):lower() == "team" then
			if not names[2] then return out("Usage: carbring team <teamname>") end
			for i = 2, #names do
				local team = D.findTeam(tostring(names[i]))
				if not team then
					out("No team found for '" .. tostring(names[i]) .. "'")
				else
					local count = 0
					for _, p in ipairs(Players:GetPlayers()) do
						if p ~= lplr and p.Team == team then add(p) count += 1 end
					end
					if count == 0 then out("No players on team " .. team.Name) end
				end
			end
		else
			for _, n in ipairs(names) do
				local matches = D.findPlayers(tostring(n))
				if #matches == 0 then out("No player found for '" .. tostring(n) .. "'") end
				for _, p in ipairs(matches) do add(p) end
			end
		end
		if #targets == 0 then return end
		if #targets > PASSENGERS_PER_TRIP then out("Bringing " .. #targets .. " players, " .. PASSENGERS_PER_TRIP .. " per trip") end

		state.busy, state.cancelled = true, false
		D.setBusy("carbring", true)
		task.spawn(function()
			local paused = D.pauseAntiSit()
			startWatchdog()
			local pending = targets
			while #pending > 0 and not state.cancelled do
				local group = {}
				while #pending > 0 and #group < PASSENGERS_PER_TRIP and not state.cancelled do
					local p = table.remove(pending, 1)
					local okPrep, usable = pcall(prepareTarget, p)
					if not okPrep then out("Error on " .. p.Name .. ": " .. tostring(usable))
					elseif usable then table.insert(group, p) end
				end
				if #group > 0 and not state.cancelled then
					local okGroup, leftover = pcall(CarBringGroup, group)
					if okGroup then
						for i = #leftover, 1, -1 do table.insert(pending, 1, leftover[i]) end -- didn't fit: front of the queue
					else
						out("Error during trip: " .. tostring(leftover))
					end
				end
			end
			stopWatchdog()
			D.resumeAntiSit(paused)
			if state.cancelled then out("Stopped") end
			state.busy, state.cancelled = false, false
			D.setBusy("carbring", false)
		end)
	end
	D.carbringRunning = function() return state.busy end
end

