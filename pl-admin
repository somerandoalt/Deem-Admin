-- Criminal + forcefield: when you respawn as a Criminal you get a forcefield, and teleporting into the prison
-- while it's on is a problem, so commands wait until it's gone before carrying on.
local PRISON_CENTER = Vector3.new(775.5, 122.74, 2328)
local PRISON_SIZE = Vector3.new(574, 300, 548)

function D.inPrison(pos)
	local rel = pos - PRISON_CENTER
	local half = PRISON_SIZE / 2
	return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
end

-- true while you're a Criminal with a forcefield and `pos` is inside the prison
function D.ffBlocks(pos)
	local char = lplr.Character
	return pos ~= nil and lplr.Team ~= nil and lplr.Team.Name == "Criminals"
		and char ~= nil and char:FindFirstChildOfClass("ForceField") ~= nil
		and D.inPrison(pos)
end

-- For loops that run every frame: true while we should hold still (says so once when it starts and when it ends)
local ffTold = false
function D.ffGate(pos, say)
	say = say or print
	if D.ffBlocks(pos) then
		if not ffTold then
			ffTold = true
			say("Waiting - you're a Criminal with a forcefield and the destination is in the prison")
		end
		return true
	end
	if ffTold then
		ffTold = false
		say("Forcefield gone - continuing")
	end
	return false
end

-- For one-off steps: yields until it's safe to teleport to getPos() (a function returning a Vector3, or nil)
function D.waitForForcefield(getPos, cancelled, say)
	while D.ffGate(getPos(), say) do
		if cancelled and cancelled() then
			ffTold = false
			break
		end
		task.wait(0.1)
	end
end

