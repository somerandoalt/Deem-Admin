	local h = t.hour % 12
	if h == 0 then h = 12 end
	return string.format("%02d:%02d:%02d %s", h, t.min, t.sec, t.hour >= 12 and "PM" or "AM")
end

local lastMessage, lastLabel, dupeCount, labelOrder = nil, nil, 1, 0
local MAX_LABELS = 500

_G.CreateLabel = function(text)
	text = tostring(text)
	if lastMessage == text and lastLabel and lastLabel.Parent then
		dupeCount += 1
		lastLabel.Text = Time() .. " - " .. text .. " (x" .. dupeCount .. ")"
		return
	end
	dupeCount = 1
	lastMessage = text
	labelOrder += 1

	local labels = {}
	for _, c in ipairs(Scroll:GetChildren()) do
		if c:IsA("TextLabel") then table.insert(labels, c) end
	end
	if #labels >= MAX_LABELS then
		table.sort(labels, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
		for i = 1, #labels - MAX_LABELS + 1 do labels[i]:Destroy() end
	end

	local tl = mk("TextLabel", {
		Name = "Line", LayoutOrder = labelOrder, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 10,
		Text = Time() .. " - " .. text, Size = UDim2.new(1, -12, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		Font = Enum.Font.SourceSans, TextSize = 14, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = WHITE, TextTransparency = 1,
	}, Scroll)
	lastLabel = tl
	TweenService:Create(tl, TweenInfo.new(0.6, Enum.EasingStyle.Linear), { TextTransparency = 0 }):Play()
	task.defer(function()
