function D.standUp()
	local _, hum = D.getMe()
	if hum then
		hum.Sit = false
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
		local t = os.clock()
		while hum.SeatPart and os.clock() - t < 1 do
			task.wait()
		end
	end
end

function D.sitIn(seat, timeout)
	local char = lplr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end
	local t = os.clock()
	repeat
		task.wait()
		if not seat.Parent then return false end
		char:PivotTo(seat.CFrame)
		seat:Sit(hum)
	until hum.SeatPart == seat or os.clock() - t > (timeout or 2)
	return hum.SeatPart == seat
end

-- Catalog animations are packages and the real animation id is inside them (same as Infinite Yield's anim2track).
-- Cached, because game:GetObjects is slow.
local animCache = {}
function D.anim2track(asset_id)
	if animCache[asset_id] then return animCache[asset_id] end
	local result = asset_id
	local ok, objs = pcall(function() return game:GetObjects(asset_id) end)
	if ok and objs then
		for i = 1, #objs do
			if objs[i]:IsA("Animation") then
				result = objs[i].AnimationId
				break
			end
		end
	end
	animCache[asset_id] = result
	return result
end

function D.getAnimator(hum)
	return hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
end

-- Cars ---------------------------------------------------------------------------------
local COOLDOWN_MSG = "Wait for the cooldown"
local BUTTON_RANGE = 12
local reportedAnswers = {}

-- Every "Car Spawner" button on the map
function D.getSpawners()
	local list, seenPos = {}, {}
	local function collect(root)
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("BasePart") and d.Name:lower() == "car spawner" then
				local key = tostring(d.Position)
				if not seenPos[key] then
					seenPos[key] = true
					table.insert(list, d)
				end
			end
		end
	end
	local items = workspace:FindFirstChild("Prison_ITEMS")
	if items then collect(items) end
	if #list == 0 then collect(workspace) end -- not where we expected: search the whole map
	return list
end

-- Goes to the spawner, presses it, and returns the new car (or nil + why)
function D.spawnAt(spawner, remote, container)
	local _, _, root = D.getMe()
	if not root then
		return nil, "your character isn't ready"
	end
	-- The server only lets us press a spawner from close by
	if (root.Position - spawner.Position).Magnitude > BUTTON_RANGE then
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = CFrame.new(spawner.Position + Vector3.new(0, 3, 0))
		task.wait(0.372) -- let the server see where we are
	end

	local Car
	local conn = container.ChildAdded:Connect(function(child)
		Car = Car or child
	end)
	local ok, result = pcall(function() return remote:InvokeServer(spawner) end)
	if ok and result ~= COOLDOWN_MSG then
		local t = os.clock()
		while not Car and os.clock() - t < 1.5 do
			task.wait()
		end
		if not Car and type(result) == "string" and not reportedAnswers[result] then
			reportedAnswers[result] = true
			D.logger("cars")("A spawner answered: \"" .. result .. "\" (no car appeared)")
		end
	end
	conn:Disconnect()

	if Car then return Car end
	if ok and result == COOLDOWN_MSG then return nil, "cooldown" end
	return nil, ok and "no car appeared" or "the press errored"
end

-- Tries every spawner until a car appears. Returns the car, or nil + why.
function D.spawnCar(say, cancelled, timeout)
	local remote = D.remote("InteractWithItem")
	local container = workspace:FindFirstChild("CarContainer")
	if not (remote and container) then return nil, "Couldn't find the car remote / CarContainer" end
	local spawners = D.getSpawners()
	if #spawners == 0 then return nil, "No 'Car Spawner' found" end
	local deadline = os.clock() + (timeout or 20)
	while os.clock() < deadline and not (cancelled and cancelled()) do
		for _, spawner in ipairs(spawners) do
			local car, why = D.spawnAt(spawner, remote, container)
			if car then return car end
			if why == "your character isn't ready" then return nil, why end
		end
		task.wait(0.1)
	end
	return nil, "Couldn't get a car"
end

-- C4 -----------------------------------------------------------------------------------
local GIVER_POS = Vector3.new(-901, 95, 2042) -- where you stand to use the C4 giver

-- Any tool with "C4" in its name counts (the item may be called "C4" or "C4 Explosive")
function D.getC4()
	local function look(container)
		if not container then return nil end
		for _, t in ipairs(container:GetChildren()) do
			if t:IsA("Tool") and t.Name:upper():find("C4", 1, true) then
				return t
			end
		end
	end
	return look(lplr.Character) or look(lplr:FindFirstChildWhichIsA("Backpack"))
end

function D.equipC4()
	local _, hum = D.getMe()
	local tool = D.getC4()
	if not (hum and tool) then return false end
	if tool.Parent ~= lplr.Character then
		hum:EquipTool(tool)
		local t = os.clock()
		while tool.Parent ~= lplr.Character and os.clock() - t < 1.5 do
			task.wait()
		end
	end
	return tool.Parent == lplr.Character
end

function D.unequip()
	local _, hum = D.getMe()
	if hum then hum:UnequipTools() end
	task.wait(0.05)
end

-- Teleports to the C4 giver and picks one up (does NOT go back). Returns true if we have a C4.
function D.grabC4(say)
	local interact = D.remote("InteractWithItem")
	local items = workspace:FindFirstChild("Prison_ITEMS")
	local giver = items and items:FindFirstChild("giver")
	local c4 = giver and giver:FindFirstChild("C4 Explosive")
	local explosive = c4 and c4:FindFirstChild("Explosive")
	if not (interact and explosive) then
		say("Couldn't find the C4 remote / giver")
		return false
	end
	for _ = 1, 8 do
		if D.getC4() then return true end
		local c, _, r = D.getMe()
		if not r then return false end -- we died
		r.AssemblyLinearVelocity = Vector3.zero
		c:PivotTo(CFrame.new(GIVER_POS))
		task.wait(0.3) -- make sure we're at the giver before pressing
		local ok, res = pcall(function() return interact:InvokeServer(explosive) end)
		local t = os.clock()
		while not D.getC4() and os.clock() - t < 1 do
			task.wait()
		end
		if D.getC4() then return true end
		if ok and type(res) == "string" then
			say("Giver answered: " .. res)
		end
	end
	return false
end
D.GIVER_POS = GIVER_POS

-- Runs a command by name or nickname (used by the stand and by the runners below)
local function resolveCommand(name)
	name = string.lower(name)
	if Commands[name] then return name end
	return Aliases[name] or name
end

function D.runCommand(name, ...)
	local cmd = resolveCommand(name)
	local fn = Commands[cmd]
	if not fn then
		error("unknown command: " .. cmd)
	end
	return fn(...)
end
_G.DeemRunCommand = D.runCommand

